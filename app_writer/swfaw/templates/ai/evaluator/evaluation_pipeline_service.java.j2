    /**
     * Evaluate an AI operation output using all configured evaluators.
     *
     * @param operationName the name of the AI operation
     * @param userId        the user who triggered the operation
     * @param inputText     the original input to the AI operation
     * @param outputText    the AI operation output to evaluate
     * @param evaluatorNames the names of evaluators to run
     * @return evaluation results as a reactive stream
     */
    public Flux<EvaluationResultDTO> evaluate(
            String operationName,
            Long userId,
            String inputText,
            String outputText,
            List<String> evaluatorNames) {
        log.debug("Running evaluators {} for operation '{}'", evaluatorNames, operationName);
        List<Mono<EvaluationResultDTO>> evaluations = evaluatorNames.stream()
                .map(name -> runEvaluator(name, operationName, userId, inputText, outputText))
                .toList();
        return Flux.merge(evaluations);
    }

    /**
     * Evaluate synchronously — blocks the response until all evaluators complete.
     * Req 10.4: Sync mode.
     * Req 10.8: Returns AiResponseWithEvaluationDTO.
     */
    public Mono<AiResponseWithEvaluationDTO> evaluateSync(
            String operationName,
            Long userId,
            String inputText,
            String outputText,
            List<String> evaluatorNames) {
        return evaluate(operationName, userId, inputText, outputText, evaluatorNames)
                .collectList()
                .map(results -> {
                    List<String> warnings = results.stream()
                            .filter(r -> "warn".equals(r.status()))
                            .map(r -> "Evaluator '" + r.evaluatorName() + "' flagged: below threshold")
                            .toList();
                    return new AiResponseWithEvaluationDTO(outputText, results, warnings);
                });
    }

    /**
     * Evaluate asynchronously — fire-and-forget on boundedElastic scheduler.
     * Req 10.4: Async mode runs in background.
     */
    public Mono<Void> evaluateAsync(
            String operationName,
            Long userId,
            String inputText,
            String outputText,
            List<String> evaluatorNames) {
        return Mono.fromRunnable(() ->
                evaluate(operationName, userId, inputText, outputText, evaluatorNames)
                        .subscribeOn(Schedulers.boundedElastic())
                        .subscribe(
                                result -> log.debug("Async evaluation result: {}", result),
                                error -> log.error("Async evaluation failed for operation '{}'", operationName, error)
                        )
        );
    }

