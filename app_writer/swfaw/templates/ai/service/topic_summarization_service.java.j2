package {{ base_package }}.ai.service;

import {{ base_package }}.ai.entity.AiChatMessage;
import {{ base_package }}.ai.entity.AiChatSession;
import {{ base_package }}.ai.entity.AiGlobalTopicHit;
import {{ base_package }}.ai.entity.AiTopic;
import {{ base_package }}.ai.entity.AiUserTopicHit;
import {{ base_package }}.ai.repository.AiChatMessageRepository;
import {{ base_package }}.ai.repository.AiGlobalTopicHitRepository;
import {{ base_package }}.ai.repository.AiTopicRepository;
import {{ base_package }}.ai.repository.AiUserTopicHitRepository;
import com.fasterxml.jackson.core.type.TypeReference;
import com.fasterxml.jackson.databind.ObjectMapper;
import lombok.extern.slf4j.Slf4j;
import org.springframework.ai.chat.client.ChatClient;
import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.stereotype.Service;
import reactor.core.publisher.Mono;

import java.time.LocalDateTime;
import java.util.List;
import java.util.stream.Collectors;

/**
 * Extracts topics from chat sessions using an LLM before session deletion.
 *
 * <p>Req 4.15: Uses ChatClient via {@code @Qualifier("{{ topic_provider_name }}")}
 * to extract up to {{ max_topics_per_session }} topic labels per session.</p>
 * <p>Req 4.16: Sends concatenated messages with a system prompt requesting
 * a JSON array of topic strings.</p>
 * <p>Req 4.17: Upserts into ai_topic, ai_user_topic_hit, and
 * ai_global_topic_hit tables.</p>
 *
 * Generated by SWFAW AI Layer generator.
 */
@Slf4j
@Service
public class TopicSummarizationService {

    private final ChatClient chatClient;
    private final AiChatMessageRepository messageRepository;
    private final AiTopicRepository topicRepository;
    private final AiUserTopicHitRepository userTopicHitRepository;
    private final AiGlobalTopicHitRepository globalTopicHitRepository;
    private final ObjectMapper objectMapper;

    private static final int MAX_TOPICS = {{ max_topics_per_session }};

    private static final String TOPIC_EXTRACTION_PROMPT =
            "Analyze the following conversation and extract the main topics discussed. " +
            "Return a JSON array of topic strings (max %d items). " +
            "Each topic should be a concise label (1-4 words). " +
            "Return ONLY the JSON array, no other text.";

    public TopicSummarizationService(
            @Qualifier("{{ topic_provider_name }}") ChatClient chatClient,
            AiChatMessageRepository messageRepository,
            AiTopicRepository topicRepository,
            AiUserTopicHitRepository userTopicHitRepository,
            AiGlobalTopicHitRepository globalTopicHitRepository,
            ObjectMapper objectMapper) {
        this.chatClient = chatClient;
        this.messageRepository = messageRepository;
        this.topicRepository = topicRepository;
        this.userTopicHitRepository = userTopicHitRepository;
        this.globalTopicHitRepository = globalTopicHitRepository;
        this.objectMapper = objectMapper;
    }

    /**
     * Extract topics from a session and upsert into topic tables.
     *
     * @param session the chat session to summarize
     * @return the number of topics extracted
     */
    public Mono<Integer> summarizeSession(AiChatSession session) {
        return messageRepository.findBySessionIdOrderByCreatedAtAsc(session.getId())
                .collectList()
                .flatMap(messages -> {
                    if (messages.isEmpty()) {
                        return Mono.just(0);
                    }

                    String concatenated = messages.stream()
                            .map(m -> m.getRole() + ": " + m.getContent())
                            .collect(Collectors.joining("\n"));

                    String systemPrompt = String.format(TOPIC_EXTRACTION_PROMPT, MAX_TOPICS);

                    return Mono.fromCallable(() ->
                            chatClient.prompt()
                                    .system(systemPrompt)
                                    .user(concatenated)
                                    .call()
                                    .content()
                    ).flatMap(response -> processTopics(response, session));
                });
    }

    private Mono<Integer> processTopics(String response, AiChatSession session) {
        try {
            List<String> topics = objectMapper.readValue(
                    response, new TypeReference<List<String>>() {});

            // Limit to max topics
            if (topics.size() > MAX_TOPICS) {
                topics = topics.subList(0, MAX_TOPICS);
            }

            LocalDateTime now = LocalDateTime.now();
            int count = 0;

            for (String topicName : topics) {
                if (topicName == null || topicName.isBlank()) {
                    continue;
                }
                String trimmed = topicName.trim();

                // Req 4.17: Upsert topic
                AiTopic topic = topicRepository.findByName(trimmed).block();
                if (topic == null) {
                    topic = new AiTopic();
                    topic.setName(trimmed);
                    topic.setCreatedAt(now);
                    topic = topicRepository.save(topic).block();
                }

                // Req 4.17: Upsert user topic hit
                AiUserTopicHit userHit = userTopicHitRepository
                        .findByUserIdAndTopicId(session.getUserId(), topic.getId())
                        .block();
                if (userHit == null) {
                    userHit = new AiUserTopicHit();
                    userHit.setUserId(session.getUserId());
                    userHit.setTopicId(topic.getId());
                    userHit.setHitCount(1);
                    userHit.setFirstSeenAt(now);
                    userHit.setLastSeenAt(now);
                } else {
                    userHit.setHitCount(userHit.getHitCount() + 1);
                    userHit.setLastSeenAt(now);
                }
                userTopicHitRepository.save(userHit).block();

                // Req 4.17: Upsert global topic hit
                AiGlobalTopicHit globalHit = globalTopicHitRepository
                        .findByTopicId(topic.getId())
                        .block();
                if (globalHit == null) {
                    globalHit = new AiGlobalTopicHit();
                    globalHit.setTopicId(topic.getId());
                    globalHit.setHitCount(1);
                    globalHit.setFirstSeenAt(now);
                    globalHit.setLastSeenAt(now);
                } else {
                    globalHit.setHitCount(globalHit.getHitCount() + 1);
                    globalHit.setLastSeenAt(now);
                }
                globalTopicHitRepository.save(globalHit).block();

                count++;
            }

            return Mono.just(count);
        } catch (Exception e) {
            log.warn("Failed to parse topic extraction response: {}", e.getMessage());
            return Mono.just(0);
        }
    }
}
