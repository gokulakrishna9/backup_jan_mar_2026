    /** Matches the innermost {{...}} pattern (non-greedy, no nested braces). */
    private static final Pattern PLACEHOLDER_PATTERN = Pattern.compile("\\{\\{([^{}]+)\\}\\}");

    /**
     * Interpolate all {{placeholder}} patterns in the template with values
     * from the supplied map. Performs a single pass — values that themselves
     * contain placeholder patterns are inserted verbatim.
     *
     * @param template the template string (may be {@code null} or empty)
     * @param values   the value map (may be {@code null} or empty)
     * @return the interpolated string, or {@code ""} if the template is {@code null}
     */
    public String interpolate(String template, Map<String, Object> values) {
        if (template == null) {
            return "";
        }
        if (template.isEmpty()) {
            return "";
        }
        if (values == null || values.isEmpty()) {
            return template;
        }

        Matcher matcher = PLACEHOLDER_PATTERN.matcher(template);
        StringBuilder result = new StringBuilder();

        while (matcher.find()) {
            String key = matcher.group(1).trim();
            if (values.containsKey(key)) {
                // Use Matcher.quoteReplacement to avoid issues with $ and \ in values
                matcher.appendReplacement(result, Matcher.quoteReplacement(String.valueOf(values.get(key))));
            } else {
                // Leave unresolved placeholder unchanged
                log.warn("Prompt template placeholder '{}' has no value in the map — left unchanged", key);
                matcher.appendReplacement(result, Matcher.quoteReplacement(matcher.group(0)));
            }
        }
        matcher.appendTail(result);

        return result.toString();
    }
