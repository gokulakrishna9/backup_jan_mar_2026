     * @return matching entity DTOs as a reactive stream
     */
    public Flux<String> aiSearch(String naturalLanguageQuery) {
        log.debug("AI search for {{ entity_name }}: {}", naturalLanguageQuery);
        String systemPrompt = "You are a search assistant for {{ entity_name }} records. "
                + "Searchable fields: {{ searchable_fields | join(', ') }}. "
                + "Translate the user query into relevant search results.";
        List<Message> messages = List.of(
                new SystemMessage(systemPrompt),
                new UserMessage(naturalLanguageQuery)
        );
        return Flux.defer(() ->
                chatClient.prompt(new Prompt(messages))
                        .stream()
                        .content()
        );
    }
