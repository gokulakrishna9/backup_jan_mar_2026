package {{ base_package }}.ai.service;

import {{ base_package }}.ai.dto.TypedResponseResult;
import {{ base_package }}.ai.provider.TypedResponseDeserializationException;
import com.fasterxml.jackson.core.JsonProcessingException;
import com.fasterxml.jackson.databind.DeserializationFeature;
import com.fasterxml.jackson.databind.ObjectMapper;
import lombok.extern.slf4j.Slf4j;
import org.springframework.ai.chat.client.ChatClient;
import org.springframework.ai.chat.messages.SystemMessage;
import org.springframework.ai.chat.messages.UserMessage;
import org.springframework.ai.chat.prompt.Prompt;
import org.springframework.stereotype.Component;
import reactor.core.publisher.Mono;

import java.util.List;

/**
 * Utility for deserializing structured LLM JSON responses with fallback behavior.
 *
 * <p>Req 7.8:  "throw" fallback returns Mono.error with TypedResponseDeserializationException.</p>
 * <p>Req 7.9:  "raw_string" fallback returns TypedResponseResult with raw response.</p>
 * <p>Req 7.10: "default_object" fallback returns TypedResponseResult with default instance.</p>
 * <p>Req 7.11: Retry on deserialization failure with correction prompt up to maxRetries.</p>
 * <p>Req 7.12: Validates response starts with {{ '{' }} or [ before deserializing.</p>
 * <p>Req 7.13: Ignores unknown properties, uses Jackson defaults for missing fields.</p>
 *
 * Generated by SWFAW AI Layer generator.
 */
@Slf4j
@Component
public class TypedResponseDeserializer {

    private final ObjectMapper objectMapper;

    public TypedResponseDeserializer() {
        this.objectMapper = new ObjectMapper();
        // Req 7.13: Ignore unknown properties and use Jackson defaults
        this.objectMapper.configure(DeserializationFeature.FAIL_ON_UNKNOWN_PROPERTIES, false);
    }

    /**
     * Deserialize an LLM response string into the target type with fallback handling.
     *
     * @param rawResponse      the raw LLM response string
     * @param targetType       the Java class to deserialize into
     * @param fallbackBehavior one of "throw", "raw_string", "default_object"
     * @param <T>              the target type
     * @return Mono containing the deserialized result or fallback
     */
    public <T> Mono<TypedResponseResult<T>> deserialize(
            String rawResponse,
            Class<T> targetType,
            String fallbackBehavior) {
        return deserializeWithRetry(rawResponse, targetType, fallbackBehavior, null, 0, 0);
    }

    /**
     * Deserialize with retry support on deserialization failure.
     *
     * <p>Req 7.11: Re-invokes the LLM with a correction prompt up to maxRetries.</p>
     *
     * @param rawResponse      the raw LLM response string
     * @param targetType       the Java class to deserialize into
     * @param fallbackBehavior one of "throw", "raw_string", "default_object"
     * @param chatClient       the ChatClient for retry invocations (nullable)
     * @param maxRetries       maximum retry attempts
     * @param currentAttempt   current attempt number (0-based)
     * @param <T>              the target type
     * @return Mono containing the deserialized result or fallback
     */
    public <T> Mono<TypedResponseResult<T>> deserializeWithRetry(
            String rawResponse,
            Class<T> targetType,
            String fallbackBehavior,
            ChatClient chatClient,
            int maxRetries,
            int currentAttempt) {

        // Req 7.12: Validate response starts with { or [
        if (rawResponse == null || rawResponse.isBlank()) {
            return handleFailure(rawResponse, targetType, fallbackBehavior,
                    "Empty response from LLM", chatClient, maxRetries, currentAttempt);
        }

        String trimmed = rawResponse.trim();
        if (!trimmed.startsWith("{") && !trimmed.startsWith("[")) {
            return handleFailure(rawResponse, targetType, fallbackBehavior,
                    "Response is not valid JSON (does not start with { or [)",
                    chatClient, maxRetries, currentAttempt);
        }

        try {
            T result = objectMapper.readValue(trimmed, targetType);
            // Req 7.7: Successful deserialization returns wrapped result
            return Mono.just(TypedResponseResult.success(result));
        } catch (JsonProcessingException e) {
            log.warn("Deserialization failed for type {}: {}",
                    targetType.getSimpleName(), e.getMessage());
            return handleFailure(rawResponse, targetType, fallbackBehavior,
                    e.getMessage(), chatClient, maxRetries, currentAttempt);
        }
    }

    private <T> Mono<TypedResponseResult<T>> handleFailure(
            String rawResponse,
            Class<T> targetType,
            String fallbackBehavior,
            String errorMessage,
            ChatClient chatClient,
            int maxRetries,
            int currentAttempt) {

        // Req 7.11: Retry with correction prompt if retries remain
        if (chatClient != null && currentAttempt < maxRetries) {
            log.info("Retrying deserialization (attempt {}/{})",
                    currentAttempt + 1, maxRetries);
            String correctionPrompt = "Your previous response could not be parsed as valid JSON "
                    + "conforming to " + targetType.getSimpleName() + ". "
                    + "Error: " + errorMessage + ". "
                    + "Please respond with ONLY valid JSON matching the expected schema.";
            return chatClient.prompt(new Prompt(List.of(
                            new SystemMessage("Respond with valid JSON only."),
                            new UserMessage(correctionPrompt)
                    )))
                    .call()
                    .content()
                    .flatMap(retryResponse -> deserializeWithRetry(
                            retryResponse, targetType, fallbackBehavior,
                            chatClient, maxRetries, currentAttempt + 1));
        }

        // Apply fallback behavior
        switch (fallbackBehavior) {
            case "raw_string":
                // Req 7.9: Return TypedResponseResult with success=false and raw response
                log.debug("Applying raw_string fallback for type {}",
                        targetType.getSimpleName());
                return Mono.just(TypedResponseResult.rawStringFallback(
                        rawResponse, errorMessage));

            case "default_object":
                // Req 7.10: Return TypedResponseResult with default-constructed instance
                log.debug("Applying default_object fallback for type {}",
                        targetType.getSimpleName());
                try {
                    T defaultInstance = targetType.getDeclaredConstructor().newInstance();
                    return Mono.just(TypedResponseResult.defaultObjectFallback(
                            defaultInstance, rawResponse, errorMessage));
                } catch (Exception e) {
                    log.error("Cannot create default instance of {}: {}",
                            targetType.getSimpleName(), e.getMessage());
                    return Mono.just(TypedResponseResult.rawStringFallback(
                            rawResponse,
                            "Failed to create default instance: " + e.getMessage()));
                }

            case "throw":
            default:
                // Req 7.8: Return Mono.error with TypedResponseDeserializationException
                return Mono.error(new TypedResponseDeserializationException(
                        targetType.getSimpleName(), rawResponse, errorMessage));
        }
    }
}
