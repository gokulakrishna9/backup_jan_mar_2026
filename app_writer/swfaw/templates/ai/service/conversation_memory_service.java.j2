package {{ base_package }}.ai.service;

import {{ base_package }}.ai.entity.AiChatMessage;
import {{ base_package }}.ai.entity.AiChatSession;
import {{ base_package }}.ai.repository.AiChatMessageRepository;
import {{ base_package }}.ai.repository.AiChatSessionRepository;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.ai.chat.messages.AssistantMessage;
import org.springframework.ai.chat.messages.Message;
import org.springframework.ai.chat.messages.SystemMessage;
import org.springframework.ai.chat.messages.UserMessage;
import org.springframework.stereotype.Service;
import reactor.core.publisher.Flux;
import reactor.core.publisher.Mono;

import java.time.LocalDateTime;
import java.util.ArrayList;
import java.util.List;
import java.util.Map;

/**
 * Manages conversation threads with role prompt sequence ordering,
 * sliding-window context (memoryWindowSize), session creation, and
 * message storage.
 *
 * <p>Req 3.1: rolePromptSequence ordering preserved.
 * Req 3.8: rolePromptSequence entries sent in exact order defined.
 * Req 3.12: Conversation context building with role ordering.
 * Req 4.5–4.8: Session creation, message storage, sliding-window context.</p>
 *
 * Generated by SWFAW AI Layer generator.
 */
@Slf4j
@Service
@RequiredArgsConstructor
public class ConversationMemoryService {

    private static final int DEFAULT_MEMORY_WINDOW_SIZE = {{ default_memory_window_size }};

    private final AiChatSessionRepository sessionRepository;
    private final AiChatMessageRepository messageRepository;
    private final PromptTemplateEngine promptTemplateEngine;

    // ------------------------------------------------------------------
    // Session management (Req 4.6, 4.7)
    // ------------------------------------------------------------------

    /**
     * Create a new entity-bound chat session.
     *
     * @param userId        the authenticated user's ID
     * @param entityType    the entity type name
     * @param entityId      the entity record ID
     * @param assistantName the assistant name from the AI_Layer definition
     * @return the persisted session with generated ID
     */
    public Mono<AiChatSession> createEntitySession(
            Long userId, String entityType, Long entityId, String assistantName) {
        LocalDateTime now = LocalDateTime.now();
        AiChatSession session = AiChatSession.builder()
                .userId(userId)
                .entityType(entityType)
                .entityId(entityId)
                .assistantName(assistantName)
                .createdAt(now)
                .lastMessageAt(now)
                .build();
        return sessionRepository.save(session);
    }

    /**
     * Create a new standalone (entity-independent) chat session.
     * Req 4.7: entityType/entityId set to null, standaloneOperationName populated.
     *
     * @param userId                  the authenticated user's ID
     * @param standaloneOperationName the standalone operation name
     * @param assistantName           the assistant name
     * @return the persisted session with generated ID
     */
    public Mono<AiChatSession> createStandaloneSession(
            Long userId, String standaloneOperationName, String assistantName) {
        LocalDateTime now = LocalDateTime.now();
        AiChatSession session = AiChatSession.builder()
                .userId(userId)
                .standaloneOperationName(standaloneOperationName)
                .assistantName(assistantName)
                .createdAt(now)
                .lastMessageAt(now)
                .build();
        return sessionRepository.save(session);
    }

    // ------------------------------------------------------------------
    // Message storage (Req 4.8)
    // ------------------------------------------------------------------

    /**
     * Store a chat message and update the session's lastMessageAt timestamp.
     *
     * @param sessionId the session ID
     * @param role      the message role (system, user, assistant, tool)
     * @param content   the message content
     * @return the persisted message
     */
    public Mono<AiChatMessage> storeMessage(Long sessionId, String role, String content) {
        AiChatMessage message = AiChatMessage.builder()
                .sessionId(sessionId)
                .role(role)
                .content(content)
                .createdAt(LocalDateTime.now())
                .build();
        return messageRepository.save(message)
                .flatMap(saved -> sessionRepository.findById(sessionId)
                        .flatMap(session -> {
                            session.setLastMessageAt(saved.getCreatedAt());
                            return sessionRepository.save(session);
                        })
                        .thenReturn(saved));
    }

    // ------------------------------------------------------------------
    // Conversation context building (Req 3.1, 3.8, 3.12, 4.5)
    // ------------------------------------------------------------------

    /**
     * Build the full message list for a chat turn: rolePromptSequence entries
     * (interpolated) followed by conversation history (sliding window)
     * followed by the new user message.
     *
     * <p>Req 3.1: rolePromptSequence ordering preserved.
     * Req 3.8: Entries sent in exact order defined, then history, then user msg.
     * Req 3.12: Context building with role ordering.</p>
     *
     * @param rolePromptSequence the ordered role/content entries (may be null)
     * @param contextValues      values for placeholder interpolation
     * @param sessionId          the session ID (null for first turn)
     * @param memoryWindowSize   max recent messages to include (0 = no history)
     * @param userMessage        the new user message
     * @return ordered list of Spring AI Message objects
     */
    public Mono<List<Message>> buildConversationContext(
            List<Map<String, String>> rolePromptSequence,
            Map<String, Object> contextValues,
            Long sessionId,
            int memoryWindowSize,
            String userMessage) {

        int windowSize = memoryWindowSize > 0 ? memoryWindowSize : DEFAULT_MEMORY_WINDOW_SIZE;

        // 1. Build role prompt sequence messages (Req 3.1, 3.8)
        List<Message> prefixMessages = buildRolePromptMessages(rolePromptSequence, contextValues);

        // 2. Load conversation history with sliding window (Req 4.5)
        Mono<List<Message>> historyMono;
        if (sessionId != null) {
            historyMono = loadRecentMessages(sessionId, windowSize);
        } else {
            historyMono = Mono.just(List.of());
        }

        // 3. Assemble: prefix + history + new user message
        return historyMono.map(history -> {
            List<Message> messages = new ArrayList<>(prefixMessages);
            messages.addAll(history);
            messages.add(new UserMessage(userMessage));
            return messages;
        });
    }

    // ------------------------------------------------------------------
    // Session queries (Req 4.3, 4.9)
    // ------------------------------------------------------------------

    /**
     * List sessions for a user, ordered by most recent activity.
     */
    public Flux<AiChatSession> listUserSessions(Long userId) {
        return sessionRepository.findByUserIdOrderByLastMessageAtDesc(userId);
    }

    /**
     * List sessions for a user filtered by standalone operation name.
     * Req 4.9: Support filtering sessions by standaloneOperationName.
     */
    public Flux<AiChatSession> listSessionsByOperation(Long userId, String operationName) {
        return sessionRepository.findByUserIdAndStandaloneOperationName(userId, operationName);
    }

    /**
     * List sessions for a user filtered by entity type and entity ID.
     */
    public Flux<AiChatSession> listSessionsByEntity(Long userId, String entityType, Long entityId) {
        return sessionRepository.findByUserIdAndEntityTypeAndEntityId(userId, entityType, entityId);
    }

    // ------------------------------------------------------------------
    // Internal helpers
    // ------------------------------------------------------------------

    /**
     * Build Spring AI Message objects from the rolePromptSequence,
     * interpolating {{placeholder}} variables via PromptTemplateEngine.
     * Preserves the exact ordering of the sequence (Req 3.1, 3.8, 3.12).
     */
    List<Message> buildRolePromptMessages(
            List<Map<String, String>> rolePromptSequence,
            Map<String, Object> contextValues) {
        if (rolePromptSequence == null || rolePromptSequence.isEmpty()) {
            return List.of();
        }
        List<Message> messages = new ArrayList<>();
        Map<String, Object> values = contextValues != null ? contextValues : Map.of();
        for (Map<String, String> entry : rolePromptSequence) {
            String role = entry.get("role");
            String content = entry.get("content");
            String interpolated = promptTemplateEngine.interpolate(content, values);
            messages.add(toSpringMessage(role, interpolated));
        }
        return messages;
    }

    /**
     * Load the most recent N messages for a session as Spring AI Message
     * objects. Applies the sliding-window (memoryWindowSize) constraint
     * (Req 4.5).
     */
    private Mono<List<Message>> loadRecentMessages(Long sessionId, int windowSize) {
        return messageRepository.findBySessionIdOrderByCreatedAtAsc(sessionId)
                .collectList()
                .map(all -> {
                    int start = Math.max(0, all.size() - windowSize);
                    List<AiChatMessage> window = all.subList(start, all.size());
                    List<Message> result = new ArrayList<>(window.size());
                    for (AiChatMessage msg : window) {
                        result.add(toSpringMessage(msg.getRole(), msg.getContent()));
                    }
                    return result;
                });
    }

    /**
     * Convert a role string to the appropriate Spring AI Message subclass.
     */
    private static Message toSpringMessage(String role, String content) {
        if (role == null) {
            return new UserMessage(content);
        }
        return switch (role.toLowerCase()) {
            case "system" -> new SystemMessage(content);
            case "assistant" -> new AssistantMessage(content);
            default -> new UserMessage(content);
        };
    }
}
