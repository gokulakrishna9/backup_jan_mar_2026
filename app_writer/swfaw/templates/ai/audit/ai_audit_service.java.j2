    /**
     * Record an audit event asynchronously (fire-and-forget).
     *
     * @param eventType       the event type (e.g. "orchestrator_request")
     * @param userId          the user ID
     * @param providerName    the provider name (nullable)
     * @param operationName   the operation name (nullable)
     * @param toolName        the tool name (nullable)
     * @param requestSummary  truncated request summary (nullable)
     * @param responseSummary truncated response summary (nullable)
     * @param durationMs      duration in milliseconds (nullable)
     * @param status          status: "success", "error", "blocked", "warned"
     * @param details         additional JSON details (nullable)
     * @param ipAddress       client IP address (nullable)
     */
    public void log(String eventType, Long userId, String providerName,
                    String operationName, String toolName,
                    String requestSummary, String responseSummary,
                    Long durationMs, String status, String details,
                    String ipAddress) {
        if (!shouldLog(eventType)) {
            return;
        }

        AiAuditLog entry = new AiAuditLog();
        entry.setEventType(eventType);
        entry.setUserId(userId);
        entry.setProviderName(providerName);
        entry.setOperationName(operationName);
        entry.setToolName(toolName);
        entry.setRequestSummary(truncate(requestSummary));
        entry.setResponseSummary(truncate(responseSummary));
        entry.setDurationMs(durationMs);
        entry.setStatus(status);
        entry.setDetails(details);
        entry.setIpAddress(ipAddress);
        entry.setCreatedAt(LocalDateTime.now());

        // Fire-and-forget on boundedElastic (Req 15.34, 15.44)
        Mono.defer(() -> auditLogRepository.save(entry).then())
                .subscribeOn(Schedulers.boundedElastic())
                .subscribe(
                        unused -> log.debug("Audit event recorded: {} for user {}", eventType, userId),
                        error -> log.warn("Failed to record audit event '{}': {}", eventType, error.getMessage())
                );
    }

    /**
     * Check whether the given event type should be logged based on config.
     * Req 15.45: When loggedEvents is empty, log all event types.
     */
    private boolean shouldLog(String eventType) {
        return LOG_ALL_EVENTS || LOGGED_EVENTS.contains(eventType);
    }

    /**
     * Truncate a summary string to MAX_SUMMARY_LENGTH characters.
     * Req 15.35: requestSummary and responseSummary truncated to 1000 chars.
     */
    private String truncate(String value) {
        if (value == null) {
            return null;
        }
        return value.length() > MAX_SUMMARY_LENGTH
                ? value.substring(0, MAX_SUMMARY_LENGTH)
                : value;
    }
