package {{ base_package }}.ai.audit;

import {{ base_package }}.ai.repository.AiAuditLogRepository;
import lombok.extern.slf4j.Slf4j;
import org.springframework.scheduling.annotation.Scheduled;
import org.springframework.stereotype.Component;

import java.time.LocalDateTime;

/**
 * Scheduled cleanup of audit records older than the configured retention period.
 *
 * <p>Req 15.38: Deletes audit records older than {@code retentionDays}
 * in batches of {{ cleanup_batch_size }} on cron {@code {{ cleanup_cron }}}.</p>
 *
 * Generated by SWFAW AI Layer generator.
 */
@Slf4j
@Component
public class AiAuditCleanupScheduler {

    private final AiAuditLogRepository auditLogRepository;

    private static final int BATCH_SIZE = {{ cleanup_batch_size }};

    public AiAuditCleanupScheduler(AiAuditLogRepository auditLogRepository) {
        this.auditLogRepository = auditLogRepository;
    }

    @Scheduled(cron = "{{ cleanup_cron }}")
    public void cleanupExpiredAuditRecords() {
        LocalDateTime cutoff = LocalDateTime.now().minusDays({{ retention_days }});
        log.info("Starting audit log cleanup for records older than {} (retention {} days)",
                cutoff, {{ retention_days }});

        long totalDeleted = 0;
        long startTime = System.currentTimeMillis();

        try {
            Long deleted;
            do {
                deleted = auditLogRepository
                        .deleteByCreatedAtBeforeLimit(cutoff, BATCH_SIZE)
                        .block();
                if (deleted != null && deleted > 0) {
                    totalDeleted += deleted;
                }
            } while (deleted != null && deleted >= BATCH_SIZE);
        } catch (Exception e) {
            log.error("Error during audit log cleanup: {}", e.getMessage(), e);
        }

        long duration = System.currentTimeMillis() - startTime;
        log.info("Audit log cleanup completed: {} records deleted in {} ms",
                totalDeleted, duration);
    }
}
