    private Flux<DocumentTaskResultDTO> chainTasksRecursive(
            Long documentId, Long userId, List<String> taskNames, int index,
            String currentInput, DocumentTaskRequestDTO request, Long previousResultId) {
        if (index >= taskNames.size()) {
            return Flux.empty();
        }
        String taskName = taskNames.get(index);
        String taskType = TASK_TYPES.get(taskName);
        String providerName = TASK_PROVIDERS.get(taskName);

        return executeTaskInternal(
                documentId, userId, taskName, taskType, providerName,
                currentInput, request, previousResultId)
                .flatMapMany(result -> {
                    if ("failed".equals(result.status())) {
                        // Req 11.17: Failed chain tasks stop the chain
                        return Flux.just(result);
                    }
                    String nextInput = result.outputText() != null ? result.outputText() : currentInput;
                    return Flux.just(result).concatWith(
                            chainTasksRecursive(documentId, userId, taskNames, index + 1,
                                    nextInput, request, result.id()));
                });
    }

    private AiDocumentTaskResult buildResult(
            Long documentId, Long userId, String taskName, String taskType,
            String providerName, String inputText, DocumentTaskRequestDTO request,
            String outputText, String status, String errorMessage,
            long durationMs, Long chainedFromResultId) {
        String inputSection = (request != null && request.targetScope() != null)
                ? request.targetScope() : "full_document";
        return AiDocumentTaskResult.builder()
                .documentId(documentId)
                .userId(userId)
                .taskName(taskName)
                .taskType(taskType)
                .providerName(providerName)
                .inputText(inputText)
                .inputSection(inputSection)
                .outputText(outputText)
                .status(status)
                .errorMessage(errorMessage)
                .executionDurationMs(durationMs)
                .chainedFromResultId(chainedFromResultId)
                .createdAt(LocalDateTime.now())
                .updatedAt(LocalDateTime.now())
                .build();
    }

