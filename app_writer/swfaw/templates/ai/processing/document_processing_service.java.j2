    private String resolveInputText(String fullText, DocumentTaskRequestDTO request) {
        if (request == null || request.targetScope() == null) {
            return fullText;
        }
        // Req 11.18: targetScope handling
        switch (request.targetScope()) {
            case "page_range":
                return extractPageRange(fullText,
                        request.startPage() != null ? request.startPage() : 1,
                        request.endPage() != null ? request.endPage() : Integer.MAX_VALUE);
            case "section":
                return extractSection(fullText,
                        request.sectionName() != null ? request.sectionName() : "");
            case "full_document":
            default:
                return fullText;
        }
    }

    private String extractPageRange(String text, int startPage, int endPage) {
        // Simplified page extraction — splits on page break markers
        String[] pages = text.split("\\f");
        StringBuilder sb = new StringBuilder();
        for (int i = Math.max(0, startPage - 1); i < Math.min(pages.length, endPage); i++) {
            sb.append(pages[i]);
        }
        return sb.length() > 0 ? sb.toString() : text;
    }

    private String extractSection(String text, String sectionName) {
        if (sectionName.isEmpty()) return text;
        int idx = text.indexOf(sectionName);
        if (idx >= 0) {
            return text.substring(idx);
        }
        return text;
    }

    private Mono<DocumentTaskResultDTO> executeTaskInternal(
            Long documentId, Long userId, String taskName, String taskType,
            String providerName, String inputText, DocumentTaskRequestDTO request,
            Long chainedFromResultId) {
        long startTime = System.currentTimeMillis();
        String prompt = buildPrompt(taskName, inputText, request);

        return Mono.fromCallable(() -> prompt)
                .flatMap(p -> {
                    // LLM call via ChatClient — provider resolved at runtime
                    log.info("Executing task '{}' (type={}) on document {} with provider '{}'",
                            taskName, taskType, documentId, providerName);
                    return invokeLlm(taskName, p);
                })
                .map(output -> buildResult(
                        documentId, userId, taskName, taskType, providerName,
                        inputText, request, output, "completed", null,
                        System.currentTimeMillis() - startTime, chainedFromResultId))
                .onErrorResume(e -> {
                    log.error("Task '{}' failed on document {}: {}", taskName, documentId, e.getMessage());
                    return Mono.just(buildResult(
                            documentId, userId, taskName, taskType, providerName,
                            inputText, request, null, "failed", e.getMessage(),
                            System.currentTimeMillis() - startTime, chainedFromResultId));
                })
                .flatMap(entity -> taskResultRepository.save(entity).map(this::toDto));
    }

    private String buildPrompt(String taskName, String inputText, DocumentTaskRequestDTO request) {
        String template = "";
{% for task in tasks %}
        if ("{{ task.name }}".equals(taskName)) template = PROMPT_{{ task.name | upper }};
{% endfor %}
        String userInstruction = (request != null && request.userInstruction() != null)
                ? request.userInstruction() : "";
        return template
                .replace("{% raw %}{{document_text}}{% endraw %}", inputText != null ? inputText : "")
                .replace("{% raw %}{{user_instruction}}{% endraw %}", userInstruction);
    }

    private Mono<String> invokeLlm(String taskName, String prompt) {
        // Dispatches to the correct ChatClient based on task name
