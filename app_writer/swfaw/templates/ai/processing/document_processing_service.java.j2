    /**
     * Execute a single document processing task.
     * Req 11.17: executeTask with provider eligibility validation.
     */
    public Mono<DocumentTaskResultDTO> executeTask(
            Long documentId, String taskName, DocumentTaskRequestDTO request, Long userId) {
        if (!TASK_TYPES.containsKey(taskName)) {
            return Mono.error(new IllegalArgumentException("Unknown task name: " + taskName));
        }

        String providerOverride = request != null ? request.providerName() : null;
        if (providerOverride != null) {
            if (!isProviderEligible(taskName, providerOverride)) {
                return Mono.error(new IllegalArgumentException(
                        "Provider '" + providerOverride + "' is not eligible for task '" + taskName + "'"));
            }
        }

        return documentRepository.findById(documentId)
                .filter(doc -> doc.getUserId().equals(userId))
                .switchIfEmpty(Mono.error(new IllegalArgumentException("Document not found or unauthorized")))
                .flatMap(doc -> {
                    String inputText = resolveInputText(doc.getExtractedText(), request);
                    String taskType = TASK_TYPES.get(taskName);
                    String providerName = providerOverride != null
                            ? providerOverride : TASK_PROVIDERS.get(taskName);
                    return executeTaskInternal(
                            documentId, userId, taskName, taskType, providerName,
                            inputText, request, null);
                });
    }

    /**
     * Chain multiple tasks sequentially, feeding output of one as input to the next.
     * Req 11.17: chainTasks — sequential execution with output chaining.
     * Failed chain tasks stop the chain.
     */
    public Flux<DocumentTaskResultDTO> chainTasks(
            Long documentId, List<String> taskNames, DocumentTaskRequestDTO request, Long userId) {
        if (taskNames == null || taskNames.isEmpty()) {
            return Flux.error(new IllegalArgumentException("Task names list must not be empty"));
        }
        for (String tn : taskNames) {
            if (!TASK_TYPES.containsKey(tn)) {
                return Flux.error(new IllegalArgumentException("Unknown task name: " + tn));
            }
        }

        return documentRepository.findById(documentId)
                .filter(doc -> doc.getUserId().equals(userId))
                .switchIfEmpty(Mono.error(new IllegalArgumentException("Document not found or unauthorized")))
                .flatMapMany(doc -> {
                    String initialInput = resolveInputText(doc.getExtractedText(), request);
                    return chainTasksRecursive(
                            documentId, userId, taskNames, 0, initialInput, request, null);
                });
    }

