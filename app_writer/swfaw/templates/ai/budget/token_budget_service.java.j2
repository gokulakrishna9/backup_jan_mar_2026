    private Mono<Map<String, Object>> evaluateBudget(Long userId, String providerName,
                                                      long dailyUsage, long monthlyUsage,
                                                      long dailyLimit, long monthlyLimit) {
        // Check daily limit (Req 15.19, 15.20, 15.21, 15.22)
        if (dailyLimit > 0 && dailyUsage >= dailyLimit) {
            return handleExceeded(providerName, dailyUsage, dailyLimit, "daily");
        }
        // Check monthly limit
        if (monthlyLimit > 0 && monthlyUsage >= monthlyLimit) {
            return handleExceeded(providerName, monthlyUsage, monthlyLimit, "monthly");
        }

        // Check warning threshold (Req 15.23)
        java.util.HashMap<String, Object> result = new java.util.HashMap<>();
        if (dailyLimit > 0) {
            double dailyPercent = (double) dailyUsage / dailyLimit * 100;
            if (dailyPercent >= warningThresholdPercent) {
                result.put("budgetWarning", String.format(
                        "Daily token usage at %.1f%% (%d/%d) for provider '%s'",
                        dailyPercent, dailyUsage, dailyLimit, providerName));
            }
        }
        if (monthlyLimit > 0) {
            double monthlyPercent = (double) monthlyUsage / monthlyLimit * 100;
            if (monthlyPercent >= warningThresholdPercent) {
                result.put("budgetWarning", String.format(
                        "Monthly token usage at %.1f%% (%d/%d) for provider '%s'",
                        monthlyPercent, monthlyUsage, monthlyLimit, providerName));
            }
        }
        return Mono.just(result);
    }

    private Mono<Map<String, Object>> handleExceeded(String providerName, long currentUsage,
                                                      long limit, String period) {
        switch (enforcementAction) {
            case "block":
                return Mono.error(new TokenBudgetExceededException(
                        providerName, currentUsage, limit, period));
            case "warn":
                log.warn("Token budget exceeded for provider '{}': {}/{} ({})", providerName, currentUsage, limit, period);
                return Mono.just(Map.of("budgetWarning", String.format(
                        "Token budget exceeded for provider '%s': %d/%d (%s)",
                        providerName, currentUsage, limit, period)));
            case "log":
                log.warn("Token budget exceeded for provider '{}': {}/{} ({})", providerName, currentUsage, limit, period);
                return Mono.just(Map.of());
            default:
                return Mono.error(new TokenBudgetExceededException(
                        providerName, currentUsage, limit, period));
        }
    }
