    public Mono<Long> getMonthlyUsage(Long userId, String providerName) {
        LocalDateTime startOfMonth = YearMonth.now().atDay(1).atStartOfDay();
        return tokenUsageRepository
                .sumTotalTokensByUserAndProviderSince(userId, providerName, startOfMonth)
                .defaultIfEmpty(0L);
    }

