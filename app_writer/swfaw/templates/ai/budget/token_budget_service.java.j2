    /**
     * Check the user's token budget before a ChatClient call.
     * Returns a Mono that completes empty if allowed, or errors if blocked.
     * The returned map may contain a "budgetWarning" key.
     */
    public Mono<Map<String, Object>> checkBudget(Long userId, String providerName) {
        long dailyLimit = getDailyLimit(providerName);
        long monthlyLimit = getMonthlyLimit(providerName);

        if (dailyLimit <= 0 && monthlyLimit <= 0) {
            // Tracking-only mode (Req 15.32)
            return Mono.just(Map.of());
        }

        LocalDateTime startOfDay = LocalDate.now().atStartOfDay();
        LocalDateTime startOfMonth = YearMonth.now().atDay(1).atStartOfDay();

        Mono<Long> dailyUsageMono = tokenUsageRepository
                .sumTotalTokensByUserAndProviderSince(userId, providerName, startOfDay)
                .defaultIfEmpty(0L);
        Mono<Long> monthlyUsageMono = tokenUsageRepository
                .sumTotalTokensByUserAndProviderSince(userId, providerName, startOfMonth)
                .defaultIfEmpty(0L);

        return Mono.zip(dailyUsageMono, monthlyUsageMono)
                .flatMap(tuple -> {
                    long dailyUsage = tuple.getT1();
                    long monthlyUsage = tuple.getT2();
                    return evaluateBudget(userId, providerName, dailyUsage, monthlyUsage, dailyLimit, monthlyLimit);
                });
    }

    /**
