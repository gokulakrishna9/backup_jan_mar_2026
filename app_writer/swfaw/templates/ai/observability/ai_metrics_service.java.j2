package {{ base_package }}.ai.observability;

import io.micrometer.core.instrument.Counter;
import io.micrometer.core.instrument.Gauge;
import io.micrometer.core.instrument.MeterRegistry;
import io.micrometer.core.instrument.Timer;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Service;

import java.time.Duration;
import java.util.concurrent.ConcurrentHashMap;
import java.util.concurrent.atomic.AtomicLong;

/**
 * AI Metrics service registering Micrometer meters for all AI operations.
 *
 * <p>Req 15.1: Registers meters via injected {@link MeterRegistry} for all
 * AI operation categories.</p>
 *
 * <p>Req 15.2: Registers counters, timers, and gauges with tags for
 * operation, provider, entity, and status.</p>
 *
 * <p>Req 15.14: All metrics recording is non-blocking and uses
 * {@link Timer.Sample} for accurate latency measurement.</p>
 *
 * <p>Req 15.16: For all AI operations executed while observability is enabled,
 * the corresponding counter is incremented and latency recorded.</p>
 *
 * Generated by SWFAW AI Layer generator.
 */
@Slf4j
@Service
public class AiMetricsService {

    private final MeterRegistry meterRegistry;
    private final ConcurrentHashMap<String, AtomicLong> gaugeValues = new ConcurrentHashMap<>();

    public AiMetricsService(MeterRegistry meterRegistry) {
        this.meterRegistry = meterRegistry;
        log.info("AiMetricsService initialized with MeterRegistry");
    }

    /**
     * Record an AI operation count.
     *
     * @param operation the operation name
     * @param provider  the provider name
     * @param entity    the entity name (nullable)
     * @param status    "success" or "error"
     */
    public void recordOperationCount(String operation, String provider, String entity, String status) {
        Counter.builder("ai.operations.count")
                .tag("operation", operation)
                .tag("provider", provider)
                .tag("entity", entity != null ? entity : "none")
                .tag("status", status)
                .register(meterRegistry)
                .increment();
    }

    /**
     * Start a latency timer sample.
     *
     * @return a {@link Timer.Sample} for accurate latency measurement
     */
    public Timer.Sample startTimer() {
        return Timer.start(meterRegistry);
    }

    /**
     * Record operation latency from a timer sample.
     *
     * @param sample    the timer sample started before the operation
     * @param operation the operation name
     * @param provider  the provider name
     */
    public void recordOperationLatency(Timer.Sample sample, String operation, String provider) {
        sample.stop(Timer.builder("ai.operations.latency")
                .tag("operation", operation)
                .tag("provider", provider)
                .publishPercentiles(0.5, 0.95, 0.99)
                .register(meterRegistry));
    }

    /**
     * Record prompt token usage.
     *
     * @param provider the provider name
     * @param tokens   the number of prompt tokens
     */
    public void recordPromptTokens(String provider, long tokens) {
        Counter.builder("ai.tokens.prompt")
                .tag("provider", provider)
                .register(meterRegistry)
                .increment(tokens);
    }

    /**
     * Record completion token usage.
     *
     * @param provider the provider name
     * @param tokens   the number of completion tokens
     */
    public void recordCompletionTokens(String provider, long tokens) {
        Counter.builder("ai.tokens.completion")
                .tag("provider", provider)
                .register(meterRegistry)
                .increment(tokens);
    }

    /**
     * Record an AI operation error.
     *
     * @param operation the operation name
     * @param provider  the provider name
     */
    public void recordError(String operation, String provider) {
        Counter.builder("ai.operations.errors")
                .tag("operation", operation)
                .tag("provider", provider)
                .register(meterRegistry)
                .increment();
    }

    /**
     * Update the active chat session gauge.
     *
     * @param count the current active session count
     */
    public void updateActiveSessionCount(long count) {
        AtomicLong gauge = gaugeValues.computeIfAbsent("ai.sessions.active", k -> {
            AtomicLong val = new AtomicLong(0);
            Gauge.builder("ai.sessions.active", val, AtomicLong::doubleValue)
                    .register(meterRegistry);
            return val;
        });
        gauge.set(count);
    }

    /**
     * Record RAG retrieval latency.
     *
     * @param sample the timer sample
     * @param source the RAG source name
     */
    public void recordRagRetrievalLatency(Timer.Sample sample, String source) {
        sample.stop(Timer.builder("ai.rag.retrieval.latency")
                .tag("source", source)
                .register(meterRegistry));
    }

    /**
     * Update RAG hit rate gauge.
     *
     * @param source  the RAG source name
     * @param hitRate the current hit rate (0.0–1.0)
     */
    public void updateRagHitRate(String source, double hitRate) {
        AtomicLong gauge = gaugeValues.computeIfAbsent("ai.rag.retrieval.hit_rate." + source, k -> {
            AtomicLong val = new AtomicLong(0);
            Gauge.builder("ai.rag.retrieval.hit_rate", val, v -> Double.longBitsToDouble(v.get()))
                    .tag("source", source)
                    .register(meterRegistry);
            return val;
        });
        gauge.set(Double.doubleToLongBits(hitRate));
    }

    /**
     * Update evaluator pass rate gauge.
     *
     * @param evaluatorName the evaluator name
     * @param passRate      the current pass rate (0.0–1.0)
     */
    public void updateEvaluatorPassRate(String evaluatorName, double passRate) {
        AtomicLong gauge = gaugeValues.computeIfAbsent("ai.evaluator.pass_rate." + evaluatorName, k -> {
            AtomicLong val = new AtomicLong(0);
            Gauge.builder("ai.evaluator.pass_rate", val, v -> Double.longBitsToDouble(v.get()))
                    .tag("evaluator", evaluatorName)
                    .register(meterRegistry);
            return val;
        });
        gauge.set(Double.doubleToLongBits(passRate));
    }

    /**
     * Record document ingestion throughput.
     *
     * @param sourceType the source type (rest, folder, database)
     */
    public void recordDocumentIngestion(String sourceType) {
        Counter.builder("ai.documents.ingestion.throughput")
                .tag("source_type", sourceType)
                .register(meterRegistry)
                .increment();
    }

    /**
     * Record document processing throughput.
     *
     * @param taskType the task type
     */
    public void recordDocumentProcessing(String taskType) {
        Counter.builder("ai.documents.processing.throughput")
                .tag("task_type", taskType)
                .register(meterRegistry)
                .increment();
    }

    /**
     * Record a moderation flag.
     *
     * @param category the flagged category
     */
    public void recordModerationFlag(String category) {
        Counter.builder("ai.moderation.flags")
                .tag("category", category)
                .register(meterRegistry)
                .increment();
    }

    /**
     * Record an MCP tool invocation.
     *
     * @param serverName the MCP server name
     * @param toolName   the tool name
     */
    public void recordMcpInvocation(String serverName, String toolName) {
        Counter.builder("ai.mcp.invocations")
                .tag("server", serverName)
                .tag("tool", toolName)
                .register(meterRegistry)
                .increment();
    }

    /**
     * Record MCP tool invocation latency.
     *
     * @param sample     the timer sample
     * @param serverName the MCP server name
     * @param toolName   the tool name
     */
    public void recordMcpLatency(Timer.Sample sample, String serverName, String toolName) {
        sample.stop(Timer.builder("ai.mcp.invocations")
                .tag("server", serverName)
                .tag("tool", toolName)
                .register(meterRegistry));
    }
}
