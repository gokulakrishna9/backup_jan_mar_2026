    private static final int ORG_ID = {{ grafana_org_id }};

    private final WebClient webClient;
    private final ObjectMapper objectMapper;

    public GrafanaDashboardProvisioningService() {
        this.objectMapper = new ObjectMapper();
        String apiKey = System.getenv(API_KEY_ENV_VAR);
        this.webClient = WebClient.builder()
                .baseUrl(GRAFANA_URL)
                .defaultHeader("Authorization", "Bearer " + (apiKey != null ? apiKey : ""))
                .defaultHeader("Content-Type", "application/json")
                .defaultHeader("X-Grafana-Org-Id", String.valueOf(ORG_ID))
                .build();
    }

    /**
     * Auto-provision dashboards on application startup.
     *
     * <p>Req 15.8: Listens for {@link ApplicationReadyEvent}.</p>
     */
    @EventListener(ApplicationReadyEvent.class)
    public void onApplicationReady() {
        log.info("Auto-provisioning Grafana dashboards on startup");
        provisionAllDashboards()
                .doOnComplete(() -> log.info("Grafana dashboard provisioning completed"))
                .doOnError(e -> log.error("Grafana dashboard provisioning failed: {}", e.getMessage()))
                .subscribe();
    }

    /**
     * Provision all configured dashboards.
     *
     * @return a Flux completing when all dashboards are provisioned
     */
    public Flux<String> provisionAllDashboards() {
        List<ObjectNode> dashboardPayloads = buildAllDashboardPayloads();
        return Flux.fromIterable(dashboardPayloads)
                .flatMap(this::provisionDashboard);
    }

    /**
     * Provision a single dashboard via the Grafana HTTP API.
     *
     * <p>Req 15.9: Sets overwrite to true to update existing dashboards.</p>
     * <p>Req 15.10: Logs errors and continues.</p>
     *
     * @param payload the dashboard JSON payload
     * @return the dashboard name on success
     */
    private Mono<String> provisionDashboard(ObjectNode payload) {
        String dashboardName = payload.path("dashboard").path("title").asText("unknown");
        return webClient.post()
                .uri("/api/dashboards/db")
                .bodyValue(payload.toString())
                .retrieve()
                .bodyToMono(String.class)
                .doOnSuccess(r -> log.info("Provisioned Grafana dashboard: {}", dashboardName))
                .onErrorResume(e -> {
                    log.error("Failed to provision Grafana dashboard '{}': {}", dashboardName, e.getMessage());
                    return Mono.just("error:" + dashboardName);
                });
    }

