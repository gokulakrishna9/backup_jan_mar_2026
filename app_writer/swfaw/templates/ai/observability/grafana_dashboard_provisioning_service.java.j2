    /**
     * Build a single dashboard JSON payload.
     *
     * @param name          the dashboard name
     * @param panels        the panel definitions
     * @param columnsPerRow the number of columns per row
     * @return the dashboard payload as an ObjectNode
     */
    private ObjectNode buildDashboardPayload(String name, List<ObjectNode> panels, int columnsPerRow) {
        ObjectNode root = objectMapper.createObjectNode();
        ObjectNode dashboard = objectMapper.createObjectNode();
        dashboard.put("title", name);
        dashboard.put("editable", true);
        dashboard.put("schemaVersion", 30);

        ArrayNode panelsArray = objectMapper.createArrayNode();
        int gridX = 0;
        int gridY = 0;
        int panelId = 1;
        int panelWidth = 24 / columnsPerRow;

        for (ObjectNode panel : panels) {
            panel.put("id", panelId++);
            ObjectNode gridPos = objectMapper.createObjectNode();
            gridPos.put("x", gridX);
            gridPos.put("y", gridY);
            gridPos.put("w", Math.min(panel.path("span").asInt(12), 24));
            gridPos.put("h", 8);
            panel.set("gridPos", gridPos);

            panelsArray.add(panel);

            gridX += panelWidth;
            if (gridX >= 24) {
                gridX = 0;
                gridY += 8;
            }
        }

        dashboard.set("panels", panelsArray);
        root.set("dashboard", dashboard);
        root.put("overwrite", true);
        root.put("folderId", 0);
        return root;
    }

    /**
     * Build a single panel definition.
     *
     * @param title      the panel title
     * @param metricName the Prometheus metric name
     * @param type       the panel type (graph, stat, gauge, table)
     * @param span       the panel span (1–24)
     * @return the panel as an ObjectNode
     */
    private ObjectNode buildPanel(String title, String metricName, String type, int span) {
        ObjectNode panel = objectMapper.createObjectNode();
        panel.put("title", title);
        panel.put("type", mapPanelType(type));
        panel.put("span", span);

        ArrayNode targets = objectMapper.createArrayNode();
        ObjectNode target = objectMapper.createObjectNode();
        target.put("expr", metricName);
        target.put("refId", "A");
        targets.add(target);
        panel.set("targets", targets);

        return panel;
    }

    /**
     * Map panel type to Grafana panel type string.
     *
     * @param type the configured panel type
     * @return the Grafana panel type
     */
    private String mapPanelType(String type) {
        return switch (type) {
            case "graph" -> "timeseries";
            case "stat" -> "stat";
            case "gauge" -> "gauge";
            case "table" -> "table";
            default -> "timeseries";
        };
    }
}
