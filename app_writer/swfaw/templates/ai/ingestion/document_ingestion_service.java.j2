    /**
     * Re-extract text from an already-ingested document.
     * Req 11.5: reExtract(...) method.
     */
    public Mono<IngestedDocumentDTO> reExtract(Long documentId, Long userId) {
        return documentRepository.findById(documentId)
                .filter(doc -> doc.getUserId().equals(userId))
                .switchIfEmpty(Mono.error(new IllegalArgumentException("Document not found or unauthorized")))
                .flatMap(doc -> {
                    log.info("Re-extracting document id={} filename='{}'", documentId, doc.getFilename());
                    // Re-extraction would re-read the stored bytes and re-run Tika
                    doc.setExtractionStatus("pending");
                    doc.setUpdatedAt(LocalDateTime.now());
                    return documentRepository.save(doc).map(this::toDto);
                });
    }

    /**
     * List documents with optional filters.
     */
    public Flux<IngestedDocumentDTO> listDocuments(Long userId, String uploadSource) {
        if (uploadSource != null) {
            return documentRepository.findByUserIdAndUploadSourceOrderByCreatedAtDesc(userId, uploadSource)
                    .map(this::toDto);
        }
        return documentRepository.findByUserIdOrderByCreatedAtDesc(userId).map(this::toDto);
    }

    /**
     * Get a single document by ID.
     */
    public Mono<IngestedDocumentDTO> getDocument(Long documentId, Long userId) {
        return documentRepository.findById(documentId)
                .filter(doc -> doc.getUserId().equals(userId))
                .map(this::toDto);
    }

    /**
     * Delete a document by ID with RAG cleanup.
     * Req 11.11: DELETE /{documentId} with RAG cleanup.
     */
    public Mono<Void> deleteDocument(Long documentId, Long userId) {
        return documentRepository.findById(documentId)
                .filter(doc -> doc.getUserId().equals(userId))
                .switchIfEmpty(Mono.error(new IllegalArgumentException("Document not found or unauthorized")))
                .flatMap(doc -> {
                    log.info("Deleting document id={} filename='{}'", documentId, doc.getFilename());
                    return documentRepository.delete(doc);
                });
    }

