    private Mono<IngestedDocumentDTO> validateAndIngest(
            byte[] fileBytes, String filename, String mimeType, Long userId,
            String uploadSource, String sourceName, Map<String, Object> metadata) {
        // Req 11.2: MIME type validation
        if (!ALLOWED_MIME_TYPES.isEmpty() && !ALLOWED_MIME_TYPES.contains(mimeType)) {
            return Mono.error(new IllegalArgumentException(
                    "Unsupported MIME type: " + mimeType + ". Allowed: " + ALLOWED_MIME_TYPES));
        }
        // Req 11.2: File size validation
        if (fileBytes.length > MAX_FILE_SIZE_BYTES) {
            return Mono.error(new IllegalArgumentException(
                    "File size " + fileBytes.length + " exceeds maximum " + MAX_FILE_SIZE_BYTES + " bytes"));
        }

        return tikaExtractorService.extract(fileBytes, filename)
                .flatMap(extraction -> {
                    String status = extraction.extractedText() != null ? "completed" : "failed";
                    AiIngestedDocument doc = AiIngestedDocument.builder()
                            .userId(userId)
                            .filename(filename)
                            .mimeType(mimeType)
                            .fileSizeBytes((long) fileBytes.length)
                            .uploadSource(uploadSource)
                            .sourceName(sourceName)
                            .extractedText(extraction.extractedText())
                            .extractionStatus(status)
                            .extractionError(extraction.error())
                            .ragSourceName({{ '"' + target_rag_source_name + '"' if target_rag_source_name else 'null' }})
                            .ragIndexed(false)
                            .createdAt(LocalDateTime.now())
                            .updatedAt(LocalDateTime.now())
                            .build();
                    return documentRepository.save(doc);
                })
{% if auto_index_on_upload and target_rag_source_name %}
                .flatMap(saved -> {
                    if ("completed".equals(saved.getExtractionStatus())) {
                        log.debug("Auto-indexing document id={} to RAG source '{}'",
                                saved.getId(), "{{ target_rag_source_name }}");
                        return ragIndexingService.indexDocument(
                                "{{ target_rag_source_name }}", saved.getId(), saved.getExtractedText())
                                .then(Mono.defer(() -> {
                                    saved.setRagIndexed(true);
                                    saved.setUpdatedAt(LocalDateTime.now());
                                    return documentRepository.save(saved);
                                }));
                    }
                    return Mono.just(saved);
                })
{% endif %}
                .map(this::toDto);
    }

    private String detectMimeType(String filename) {
        if (filename.endsWith(".pdf")) return "application/pdf";
        if (filename.endsWith(".docx")) return "application/vnd.openxmlformats-officedocument.wordprocessingml.document";
        if (filename.endsWith(".txt")) return "text/plain";
        if (filename.endsWith(".html")) return "text/html";
        if (filename.endsWith(".csv")) return "text/csv";
        return "application/octet-stream";
    }

    private IngestedDocumentDTO toDto(AiIngestedDocument entity) {
        return new IngestedDocumentDTO(
                entity.getId(),
                entity.getUserId(),
                entity.getFilename(),
                entity.getMimeType(),
                entity.getFileSizeBytes(),
                entity.getUploadSource(),
                entity.getSourceName(),
                entity.getExtractionStatus(),
                entity.getExtractionError(),
                entity.getRagSourceName(),
                entity.getRagIndexed(),
                Map.of(),
                entity.getCreatedAt(),
                entity.getUpdatedAt()
        );
    }
