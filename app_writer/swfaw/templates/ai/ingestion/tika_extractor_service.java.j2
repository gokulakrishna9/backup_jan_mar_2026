package {{ base_package }}.ai.ingestion;

import {{ base_package }}.ai.dto.TikaExtractionResultDTO;
import lombok.extern.slf4j.Slf4j;
import org.apache.tika.Tika;
import org.apache.tika.language.detect.LanguageDetector;
import org.apache.tika.metadata.Metadata;
import org.apache.tika.parser.AutoDetectParser;
import org.apache.tika.sax.BodyContentHandler;
import org.springframework.stereotype.Service;
import reactor.core.publisher.Mono;
import reactor.core.scheduler.Schedulers;

import java.io.ByteArrayInputStream;
import java.util.HashMap;
import java.util.Map;

/**
 * Service for extracting text from documents using Apache Tika.
 *
 * <p>Req 11.6: TikaExtractorService with extract(byte[], String) returning
 * Mono&lt;TikaExtractionResultDTO&gt;. When Tika cannot parse, returns result
 * with null extractedText and error field, and sets extraction_status to
 * "failed".</p>
 *
 * Generated by SWFAW AI Layer generator.
 */
@Slf4j
@Service
public class TikaExtractorService {

    private final Tika tika = new Tika();
    private final AutoDetectParser parser = new AutoDetectParser();

    /**
     * Extract text content from a document byte array.
     *
     * @param documentBytes the raw document bytes
     * @param filename      the original filename (used for MIME detection)
     * @return extraction result with text, detected MIME type, language, and metadata
     */
    public Mono<TikaExtractionResultDTO> extract(byte[] documentBytes, String filename) {
        return Mono.fromCallable(() -> doExtract(documentBytes, filename))
                .subscribeOn(Schedulers.boundedElastic());
    }

    private TikaExtractionResultDTO doExtract(byte[] documentBytes, String filename) {
        try {
            Metadata metadata = new Metadata();
            metadata.set(Metadata.RESOURCE_NAME_KEY, filename);
            BodyContentHandler handler = new BodyContentHandler(-1);
            parser.parse(new ByteArrayInputStream(documentBytes), handler, metadata);

            String extractedText = handler.toString();
            String detectedMimeType = tika.detect(documentBytes, filename);
            String detectedLanguage = null;
            try {
                LanguageDetector detector = LanguageDetector.getDefaultLanguageDetector().loadModels();
                detectedLanguage = detector.detect(extractedText).getLanguage();
            } catch (Exception e) {
                log.warn("Language detection failed for '{}': {}", filename, e.getMessage());
            }

            Map<String, String> metadataMap = new HashMap<>();
            for (String name : metadata.names()) {
                metadataMap.put(name, metadata.get(name));
            }

            log.debug("Extracted {} chars from '{}'", extractedText.length(), filename);
            return new TikaExtractionResultDTO(extractedText, detectedMimeType, detectedLanguage, metadataMap, null);
        } catch (Exception e) {
            log.error("Tika extraction failed for '{}': {}", filename, e.getMessage());
            return new TikaExtractionResultDTO(null, null, null, Map.of(), e.getMessage());
        }
    }
}
