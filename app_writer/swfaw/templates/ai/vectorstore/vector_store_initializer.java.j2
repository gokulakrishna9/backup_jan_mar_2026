package {{ base_package }}.ai.vectorstore;

import lombok.extern.slf4j.Slf4j;
import org.springframework.boot.context.event.ApplicationReadyEvent;
import org.springframework.context.event.EventListener;
import org.springframework.stereotype.Component;
import reactor.core.publisher.Flux;

import java.util.List;

/**
 * Initializes vector store collections on application startup for each
 * enabled Semantic RAG source using the configured collection prefix.
 * Generated by SWFAW AI Layer generator.
 *
 * Req 8.8: VectorStoreInitializer creates collections on startup for each
 *          enabled Semantic RAG source using collectionPrefix + sourceName.
 */
@Slf4j
@Component
public class VectorStoreInitializer {

    private final VectorStore vectorStore;
    private final String collectionPrefix;
    private final List<String> semanticSourceNames;

    public VectorStoreInitializer(
            VectorStore vectorStore,
            @org.springframework.beans.factory.annotation.Value("${ai.vector-store.collection-prefix:{{ collection_prefix }}}") String collectionPrefix) {
        this.vectorStore = vectorStore;
        this.collectionPrefix = collectionPrefix;
        this.semanticSourceNames = List.of({{ semantic_source_names_java }});
    }

    @EventListener(ApplicationReadyEvent.class)
    public void initializeCollections() {
        log.info("Initializing vector store collections with prefix '{}'", collectionPrefix);
        Flux.fromIterable(semanticSourceNames)
                .flatMap(sourceName -> {
                    String collectionName = collectionPrefix + sourceName;
                    return vectorStore.collectionExists(collectionName)
                            .flatMap(exists -> {
                                if (!exists) {
                                    log.info("Collection '{}' does not exist — will be created on first store", collectionName);
                                } else {
                                    log.info("Collection '{}' already exists", collectionName);
                                }
                                return reactor.core.publisher.Mono.empty();
                            });
                })
                .subscribe();
    }
}
