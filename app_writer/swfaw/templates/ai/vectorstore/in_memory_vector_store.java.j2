package {{ base_package }}.ai.vectorstore;

import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Component;
import reactor.core.publisher.Flux;
import reactor.core.publisher.Mono;

import java.util.*;
import java.util.concurrent.ConcurrentHashMap;
import java.util.stream.Collectors;

/**
 * In-memory VectorStore using ConcurrentHashMap with brute-force cosine similarity.
 * Generated by SWFAW AI Layer generator.
 *
 * Req 8.6: InMemoryVectorStore using ConcurrentHashMap with brute-force cosine similarity.
 * Req 8.15: Translates VectorSecurityFilter into Java predicate.
 */
@Slf4j
@Component
public class InMemoryVectorStore implements VectorStore {

    private record EmbeddingEntry(String id, float[] embedding, String text, Map<String, Object> metadata) {}

    private final ConcurrentHashMap<String, List<EmbeddingEntry>> collections = new ConcurrentHashMap<>();

    public InMemoryVectorStore() {
        log.info("Initialized InMemoryVectorStore");
    }

    @Override
    public Mono<Void> store(String collection, String id, float[] embedding, String text, Map<String, Object> metadata) {
        return Mono.fromRunnable(() -> {
            collections.computeIfAbsent(collection, k -> Collections.synchronizedList(new ArrayList<>()))
                    .add(new EmbeddingEntry(id, embedding, text, metadata != null ? metadata : Map.of()));
            log.debug("Stored embedding '{}' in in-memory collection '{}'", id, collection);
        });
    }

    @Override
    public Flux<VectorSearchResult> search(String collection, float[] queryEmbedding, int topK, Map<String, Object> securityFilter) {
        return Mono.fromCallable(() -> {
            List<EmbeddingEntry> entries = collections.getOrDefault(collection, Collections.emptyList());
            return entries.stream()
                    .filter(e -> matchesFilter(e.metadata(), securityFilter))
                    .map(e -> new VectorSearchResult(e.id(), e.text(), cosineSimilarity(queryEmbedding, e.embedding()), e.metadata()))
                    .sorted(Comparator.comparingDouble(VectorSearchResult::score).reversed())
                    .limit(topK)
                    .collect(Collectors.toList());
        }).flatMapMany(Flux::fromIterable);
    }

    @Override
    public Mono<Void> delete(String collection, String id) {
        return Mono.fromRunnable(() -> {
            List<EmbeddingEntry> entries = collections.get(collection);
            if (entries != null) {
                entries.removeIf(e -> e.id().equals(id));
            }
        });
    }

    @Override
    public Mono<Long> deleteByFilter(String collection, Map<String, Object> filter) {
        return Mono.fromCallable(() -> {
            List<EmbeddingEntry> entries = collections.get(collection);
            if (entries == null || filter == null || filter.isEmpty()) {
                return 0L;
            }
            long count = entries.stream().filter(e -> matchesFilter(e.metadata(), filter)).count();
            entries.removeIf(e -> matchesFilter(e.metadata(), filter));
            return count;
        });
    }

    @Override
    public Mono<Boolean> collectionExists(String collection) {
        return Mono.just(collections.containsKey(collection));
    }

    private boolean matchesFilter(Map<String, Object> metadata, Map<String, Object> filter) {
        if (filter == null || filter.isEmpty()) {
            return true;
        }
        for (Map.Entry<String, Object> entry : filter.entrySet()) {
            Object metaValue = metadata.get(entry.getKey());
            if (metaValue == null || !metaValue.equals(entry.getValue())) {
                return false;
            }
        }
        return true;
    }

    private double cosineSimilarity(float[] a, float[] b) {
        if (a.length != b.length) return 0.0;
        double dotProduct = 0.0, normA = 0.0, normB = 0.0;
        for (int i = 0; i < a.length; i++) {
            dotProduct += a[i] * b[i];
            normA += a[i] * a[i];
            normB += b[i] * b[i];
        }
        double denominator = Math.sqrt(normA) * Math.sqrt(normB);
        return denominator == 0.0 ? 0.0 : dotProduct / denominator;
    }
}
