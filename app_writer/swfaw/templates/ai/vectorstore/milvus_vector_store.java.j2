    }

    @Override
    public Mono<Void> store(String collection, String id, float[] embedding, String text, Map<String, Object> metadata) {
        return Mono.fromRunnable(() -> {
            ensureCollection(collection, embedding.length);
            List<InsertParam.Field> fields = new ArrayList<>();
            fields.add(new InsertParam.Field("id", Collections.singletonList(id)));
            fields.add(new InsertParam.Field("embedding", Collections.singletonList(Arrays.asList(toFloatList(embedding)))));
            fields.add(new InsertParam.Field("text", Collections.singletonList(text)));
            if (metadata != null) {
                fields.add(new InsertParam.Field("metadata", Collections.singletonList(metadata.toString())));
            }
            client.insert(InsertParam.newBuilder()
                    .withCollectionName(collection)
                    .withFields(fields)
                    .build());
            log.debug("Stored embedding '{}' in collection '{}'", id, collection);
        }).subscribeOn(Schedulers.boundedElastic()).then();
    }

    @Override
    public Flux<VectorSearchResult> search(String collection, float[] queryEmbedding, int topK, Map<String, Object> securityFilter) {
        return Mono.fromCallable(() -> {
            String filterExpr = buildMilvusFilter(securityFilter);
            SearchParam.Builder builder = SearchParam.newBuilder()
                    .withCollectionName(collection)
                    .withMetricType(MetricType.L2)
                    .withTopK(topK)
                    .withVectors(Collections.singletonList(Arrays.asList(toFloatList(queryEmbedding))))
                    .withVectorFieldName("embedding")
                    .withOutFields(Arrays.asList("id", "text", "metadata"));
            if (filterExpr != null && !filterExpr.isEmpty()) {
                builder.withExpr(filterExpr);
            }
            R<SearchResults> response = client.search(builder.build());
            return response;
        }).subscribeOn(Schedulers.boundedElastic())
          .flatMapMany(response -> Flux.fromIterable(convertResults(response)));
    }

    @Override
    public Mono<Void> delete(String collection, String id) {
        return Mono.fromRunnable(() -> {
            client.delete(DeleteParam.newBuilder()
                    .withCollectionName(collection)
                    .withExpr("id == \"" + id + "\"")
                    .build());
            log.debug("Deleted embedding '{}' from collection '{}'", id, collection);
        }).subscribeOn(Schedulers.boundedElastic()).then();
    }

    @Override
    public Mono<Long> deleteByFilter(String collection, Map<String, Object> filter) {
        return Mono.fromCallable(() -> {
            String filterExpr = buildMilvusFilter(filter);
            if (filterExpr == null || filterExpr.isEmpty()) {
                return 0L;
            }
            client.delete(DeleteParam.newBuilder()
                    .withCollectionName(collection)
                    .withExpr(filterExpr)
                    .build());
            return 1L; // Milvus does not return delete count directly
        }).subscribeOn(Schedulers.boundedElastic());
    }

    @Override
    public Mono<Boolean> collectionExists(String collection) {
        return Mono.fromCallable(() -> {
            R<Boolean> response = client.hasCollection(
                    HasCollectionParam.newBuilder().withCollectionName(collection).build());
            return response.getData() != null && response.getData();
        }).subscribeOn(Schedulers.boundedElastic());
    }

    private void ensureCollection(String collection, int dimension) {
        R<Boolean> exists = client.hasCollection(
                HasCollectionParam.newBuilder().withCollectionName(collection).build());
        if (exists.getData() == null || !exists.getData()) {
            log.info("Creating Milvus collection '{}' with dimension {}", collection, dimension);
            // Collection creation with IVF_FLAT index would be configured here
        }
    }

    private String buildMilvusFilter(Map<String, Object> securityFilter) {
        if (securityFilter == null || securityFilter.isEmpty()) {
            return null;
        }
        // Req 8.15: Translate VectorSecurityFilter into Milvus expression filter
        StringBuilder expr = new StringBuilder();
        for (Map.Entry<String, Object> entry : securityFilter.entrySet()) {
            if (expr.length() > 0) {
                expr.append(" && ");
            }
            expr.append(entry.getKey()).append(" == \"").append(entry.getValue()).append("\"");
        }
        return expr.toString();
    }

