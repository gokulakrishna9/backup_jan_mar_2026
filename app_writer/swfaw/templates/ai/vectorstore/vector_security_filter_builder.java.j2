/**
 * Utility class that constructs vector security filters from Spring Security
 * Authentication objects for per-user/per-role filtering on vector store searches.
 * Generated by SWFAW AI Layer generator.
 *
 * Req 8.17: VectorSecurityFilterBuilder constructs filters from Authentication objects.
 * Req 8.13: Includes user_id and security_groups in filter for role_restricted sources.
 * Req 8.16: Returns null for public sources.
 */
@Slf4j
@Component
public class VectorSecurityFilterBuilder {

    /**
     * Build a security filter map for a role-restricted vector store search.
     * Returns null when securityMode is "public".
     *
     * @param authentication the current user's authentication
     * @param securityMode   "public" or "role_restricted"
     * @return filter map or null
     */
    public Map<String, Object> buildFilter(Authentication authentication, String securityMode) {
        if ("public".equals(securityMode)) {
            return null;
        }
        if (authentication == null) {
            log.warn("No security context available for role_restricted vector search — returning empty filter");
            return Map.of();
        }
        Map<String, Object> filter = new HashMap<>();
        filter.put("user_id", authentication.getName());
