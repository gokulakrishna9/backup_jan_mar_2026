package {{ base_package }}.ai.config;

import {{ base_package }}.ai.vectorstore.*;
import org.springframework.boot.autoconfigure.condition.ConditionalOnProperty;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.beans.factory.annotation.Value;
import lombok.extern.slf4j.Slf4j;

/**
 * Configuration class that selects the VectorStore implementation based on
 * the {@code ai.vector-store.type} property.
 * Generated by SWFAW AI Layer generator.
 *
 * Req 8.7: VectorStoreConfig using @ConditionalOnProperty to select implementation.
 * Req 8.9: application.properties entries for ai.vector-store.* configuration.
 */
@Slf4j
@Configuration
public class VectorStoreConfig {
{% if vector_store_type == 'milvus' %}

    @Bean
    @ConditionalOnProperty(name = "ai.vector-store.type", havingValue = "milvus", matchIfMissing = true)
    public VectorStore milvusVectorStore(
            @Value("${ai.vector-store.host:{{ host }}}") String host,
            @Value("${ai.vector-store.port:{{ port }}}") int port,
            @Value("${ai.vector-store.connect-timeout-ms:{{ connect_timeout_ms }}}") int connectTimeoutMs) {
        log.info("Configuring MilvusVectorStore at {}:{}", host, port);
        return new MilvusVectorStore(host, port, connectTimeoutMs);
    }
{% endif %}
{% if vector_store_type == 'qdrant' %}

    @Bean
    @ConditionalOnProperty(name = "ai.vector-store.type", havingValue = "qdrant")
    public VectorStore qdrantVectorStore() {
        log.info("Configuring QdrantVectorStore (placeholder)");
        return new QdrantVectorStore();
    }
{% endif %}
{% if vector_store_type == 'pgvector' %}

    @Bean
    @ConditionalOnProperty(name = "ai.vector-store.type", havingValue = "pgvector")
    public VectorStore pgVectorStore() {
        log.info("Configuring PgVectorStore (placeholder)");
        return new PgVectorStore();
    }
{% endif %}
{% if vector_store_type == 'in_memory' %}

    @Bean
    @ConditionalOnProperty(name = "ai.vector-store.type", havingValue = "in_memory")
    public VectorStore inMemoryVectorStore() {
        log.info("Configuring InMemoryVectorStore");
        return new InMemoryVectorStore();
    }
{% endif %}
}
