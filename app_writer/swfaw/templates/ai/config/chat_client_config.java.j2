package {{ base_package }}.ai.config;

import org.springframework.ai.chat.client.ChatClient;
import org.springframework.ai.embedding.EmbeddingModel;
{% for provider in providers %}
{% if provider.type == 'openai' %}
import org.springframework.ai.openai.OpenAiChatModel;
import org.springframework.ai.openai.OpenAiChatOptions;
import org.springframework.ai.openai.OpenAiEmbeddingModel;
import org.springframework.ai.openai.OpenAiEmbeddingOptions;
import org.springframework.ai.openai.api.OpenAiApi;
{% elif provider.type == 'ollama' %}
import org.springframework.ai.ollama.OllamaChatModel;
import org.springframework.ai.ollama.OllamaEmbeddingModel;
import org.springframework.ai.ollama.api.OllamaApi;
import org.springframework.ai.ollama.api.OllamaOptions;
{% endif %}
{% endfor %}
import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
{% if providers | length == 1 %}
import org.springframework.context.annotation.Primary;
{% endif %}
import lombok.extern.slf4j.Slf4j;

/**
 * Configuration class for AI provider ChatClient and EmbeddingModel beans.
 * Generated by SWFAW AI Layer generator.
 */
@Slf4j
@Configuration
public class ChatClientConfig {
{% for provider in providers %}

    // --- {{ provider.name }} ({{ provider.type }}) ---

    @Value("${ai.providers.{{ provider.name }}.model}")
    private String {{ provider.name }}Model;

    @Value("${ai.providers.{{ provider.name }}.embedding-model:${ai.providers.{{ provider.name }}.model}}")
    private String {{ provider.name }}EmbeddingModel;

    @Value("${ai.providers.{{ provider.name }}.temperature:{{ provider.temperature | default(0.7) }}}")
    private double {{ provider.name }}Temperature;

    @Value("${ai.providers.{{ provider.name }}.max-tokens:{{ provider.maxTokens | default(2048) }}}")
    private int {{ provider.name }}MaxTokens;
{% if provider.type == 'openai' %}

    @Value("${ai.providers.{{ provider.name }}.api-key:${OPENAI_API_KEY:}}")
    private String {{ provider.name }}ApiKey;

    @Value("${ai.providers.{{ provider.name }}.base-url:https://api.openai.com}")
    private String {{ provider.name }}BaseUrl;
{% elif provider.type == 'ollama' %}

    @Value("${ai.providers.{{ provider.name }}.base-url:http://localhost:11434}")
    private String {{ provider.name }}BaseUrl;
{% endif %}

    @Bean
    @Qualifier("{{ provider.name }}")
{% if providers | length == 1 %}
    @Primary
{% endif %}
    public ChatClient {{ provider.name }}ChatClient() {
{% if provider.type == 'openai' %}
        var api = new OpenAiApi({{ provider.name }}BaseUrl, {{ provider.name }}ApiKey);
        var options = OpenAiChatOptions.builder()
                .model({{ provider.name }}Model)
                .temperature({{ provider.name }}Temperature)
                .maxTokens({{ provider.name }}MaxTokens)
                .build();
        var chatModel = new OpenAiChatModel(api, options);
{% elif provider.type == 'ollama' %}
        var api = new OllamaApi({{ provider.name }}BaseUrl);
        var options = OllamaOptions.builder()
                .model({{ provider.name }}Model)
                .temperature({{ provider.name }}Temperature)
                .numPredict({{ provider.name }}MaxTokens)
                .build();
        var chatModel = new OllamaChatModel(api, options);
{% endif %}
        log.info("Initialized ChatClient for provider '{{ provider.name }}' ({{ provider.type }}) with model '{}'", {{ provider.name }}Model);
        return ChatClient.builder(chatModel).build();
    }

    @Bean
    @Qualifier("{{ provider.name }}")
{% if providers | length == 1 %}
    @Primary
{% endif %}
    public EmbeddingModel {{ provider.name }}EmbeddingModel() {
{% if provider.type == 'openai' %}
        var api = new OpenAiApi({{ provider.name }}BaseUrl, {{ provider.name }}ApiKey);
        var embeddingOptions = OpenAiEmbeddingOptions.builder()
                .model({{ provider.name }}EmbeddingModel)
                .build();
        log.info("Initialized EmbeddingModel for provider '{{ provider.name }}' (openai) with model '{}'", {{ provider.name }}EmbeddingModel);
        return new OpenAiEmbeddingModel(api, embeddingOptions);
{% elif provider.type == 'ollama' %}
        var api = new OllamaApi({{ provider.name }}BaseUrl);
        var embeddingOptions = OllamaOptions.builder()
                .model({{ provider.name }}EmbeddingModel)
                .build();
        log.info("Initialized EmbeddingModel for provider '{{ provider.name }}' (ollama) with model '{}'", {{ provider.name }}EmbeddingModel);
        return new OllamaEmbeddingModel(api, embeddingOptions);
{% endif %}
    }
{% endfor %}
}
