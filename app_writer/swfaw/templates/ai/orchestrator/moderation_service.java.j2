    /**
     * Moderate the given content against configured categories.
     *
     * <p>Req 13.24/13.25: Applies the configured failureAction when
     * moderation flags the content.</p>
     *
     * @param content the content to moderate
     * @return Mono containing the moderation result
     */
    public Mono<ModerationResultDTO> moderate(String content) {
        return moderationChatClient.prompt()
                .user(content)
                .call()
                .content()
                .map(response -> parseModerationResponse(response))
                .doOnNext(result -> {
                    if (result.flagged()) {
                        switch (FAILURE_ACTION) {
                            case "block" -> log.warn("Moderation blocked content: categories={}", result.categories());
                            case "warn" -> log.warn("Moderation warning for content: categories={}", result.categories());
                            case "log" -> log.info("Moderation flagged content: categories={}", result.categories());
                        }
                    }
                })
                .onErrorResume(e -> {
                    log.error("Moderation check failed: {}", e.getMessage());
                    Map<String, Boolean> emptyCategories = new HashMap<>();
                    Map<String, Double> emptyScores = new HashMap<>();
                    return Mono.just(new ModerationResultDTO(false, emptyCategories, emptyScores, FAILURE_ACTION));
                });
    }

    /**
     * Parse the moderation provider response into a ModerationResultDTO.
     *
     * @param response the raw moderation response
     * @return the parsed moderation result
     */
    private ModerationResultDTO parseModerationResponse(String response) {
        Map<String, Boolean> categoryFlags = new HashMap<>();
        Map<String, Double> categoryScores = new HashMap<>();
        boolean flagged = false;

        for (String category : CATEGORIES) {
            boolean isFlagged = response != null && response.toLowerCase().contains(category);
            categoryFlags.put(category, isFlagged);
            categoryScores.put(category, isFlagged ? 1.0 : 0.0);
            if (isFlagged) {
                flagged = true;
            }
        }

        return new ModerationResultDTO(flagged, categoryFlags, categoryScores, FAILURE_ACTION);
    }

