/**
 * Canary Word Advisor service that injects canary tokens into system
 * prompts and detects system prompt leakage in LLM responses.
 *
 * <p>Req 13.18: Injects canary tokens from the configured list (or
 * auto-generated tokens if the list is empty) into the system prompt.
 * When the LLM response contains any canary token, flags the response
 * as a potential system prompt leak.</p>
 *
 * <p>Req 13.22: For all LLM responses containing canary tokens, the
 * service SHALL flag the response as a system prompt leak (canary
 * detection invariant).</p>
 *
 * <p>Req 13.28: Executes within the reactive pipeline using non-blocking
 * operations and can be independently enabled or disabled.</p>
 *
 * Generated by SWFAW AI Layer generator.
 */
@Slf4j
@Service
public class CanaryWordAdvisorService {

{% if canary_tokens %}
    private static final List<String> CANARY_TOKENS = List.of(
{% for token in canary_tokens %}
            "{{ token }}"{{ "," if not loop.last else "" }}
{% endfor %}
    );
{% else %}
    private static final List<String> CANARY_TOKENS;

    static {
        CANARY_TOKENS = IntStream.range(0, 3)
                .mapToObj(i -> "CANARY-" + UUID.randomUUID().toString().substring(0, 8))
                .collect(Collectors.toUnmodifiableList());
    }
{% endif %}

    /**
     * Get the canary tokens to inject into the system prompt.
     *
     * @return list of canary token strings
     */
    public List<String> getCanaryTokens() {
        return CANARY_TOKENS;
    }

    /**
     * Inject canary tokens into the given system prompt.
     *
     * @param systemPrompt the original system prompt
     * @return the system prompt with canary tokens appended
     */
    public String injectCanaryTokens(String systemPrompt) {
        StringBuilder sb = new StringBuilder(systemPrompt);
        sb.append("\n[CANARY: ");
        sb.append(String.join(", ", CANARY_TOKENS));
        sb.append("]");
        return sb.toString();
    }

    /**
     * Check whether the given LLM response contains any canary tokens,
     * indicating a potential system prompt leak.
     *
     * @param llmResponse the LLM response to check
     * @return {@code true} if the response contains a canary token
     */
    public boolean detectLeakage(String llmResponse) {
        if (llmResponse == null || llmResponse.isBlank()) {
            return false;
        }
        return CANARY_TOKENS.stream().anyMatch(llmResponse::contains);
    }

    /**
     * Validate an LLM response reactively. Returns a warning if leakage
     * is detected, or an empty Mono if safe.
     *
     * @param llmResponse the LLM response to check
     * @return Mono with warning message if leaked, empty Mono if safe
     */
    public Mono<String> validate(String llmResponse) {
        if (detectLeakage(llmResponse)) {
            log.warn("CanaryWord detected system prompt leakage in LLM response");
            return Mono.just("System prompt leakage detected in response.");
        }
        return Mono.empty();
    }
}
