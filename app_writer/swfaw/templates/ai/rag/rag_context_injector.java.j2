package {{ base_package }}.ai.rag;

import lombok.extern.slf4j.Slf4j;
import org.springframework.ai.chat.messages.Message;
import org.springframework.ai.chat.messages.SystemMessage;
import org.springframework.stereotype.Component;

import java.util.ArrayList;
import java.util.List;
import java.util.stream.Collectors;

/**
 * Utility that prepends retrieved RAG context with source attribution
 * to the prompt or Role_Prompt_Sequence.
 *
 * <p>Req 9.8: Prepends retrieved context with source attribution to the system role entry.
 * Req 9.9: When RAG returns zero results, proceeds with original prompt and logs warning.</p>
 *
 * Generated by SWFAW AI Layer generator.
 */
@Slf4j
@Component
public class RagContextInjector {

    private static final String CONTEXT_HEADER = "\n\n--- Retrieved Context ---\n";
    private static final String CONTEXT_FOOTER = "\n--- End Context ---\n\n";

    /**
     * Inject RAG results into a message list by prepending context
     * to the system message.
     *
     * @param messages   the original message list
     * @param ragResults the retrieved RAG results
     * @return a new message list with context injected
     */
    public List<Message> injectContext(List<Message> messages, List<RagResultDTO> ragResults) {
        if (ragResults == null || ragResults.isEmpty()) {
            log.warn("RAG returned zero results — proceeding with original prompt");
            return messages;
        }

        String contextBlock = buildContextBlock(ragResults);
        List<Message> result = new ArrayList<>(messages.size());

        boolean injected = false;
        for (Message msg : messages) {
            if (!injected && msg instanceof SystemMessage systemMsg) {
                String enriched = systemMsg.getContent() + contextBlock;
                result.add(new SystemMessage(enriched));
                injected = true;
            } else {
                result.add(msg);
            }
        }

        // If no system message found, prepend a new one with context
        if (!injected) {
            result.add(0, new SystemMessage("Use the following context to answer:" + contextBlock));
        }

        log.debug("Injected {} RAG results into prompt", ragResults.size());
        return result;
    }

    /**
     * Build a formatted context block from RAG results with source attribution.
     */
    private String buildContextBlock(List<RagResultDTO> ragResults) {
        String entries = ragResults.stream()
                .map(r -> String.format("[Source: %s, Entity: %s/%s, Field: %s, Score: %.3f]\n%s",
                        r.sourceName(),
                        r.entityType() != null ? r.entityType() : "N/A",
                        r.entityId() != null ? r.entityId().toString() : "N/A",
                        r.fieldName() != null ? r.fieldName() : "N/A",
                        r.score(),
                        r.sourceText()))
                .collect(Collectors.joining("\n\n"));
        return CONTEXT_HEADER + entries + CONTEXT_FOOTER;
    }

    /**
     * Extract the original prompt from a context-injected string.
     * Useful for round-trip verification.
     */
    public String extractOriginalPrompt(String injectedPrompt) {
        int headerIdx = injectedPrompt.indexOf(CONTEXT_HEADER);
        int footerIdx = injectedPrompt.indexOf(CONTEXT_FOOTER);
        if (headerIdx >= 0 && footerIdx >= 0) {
            return injectedPrompt.substring(0, headerIdx)
                    + injectedPrompt.substring(footerIdx + CONTEXT_FOOTER.length());
        }
        return injectedPrompt;
    }
}
