package {{ base_package }}.ai.scheduler;

import {{ base_package }}.ai.repository.AiChatMessageRepository;
import {{ base_package }}.ai.repository.AiChatSessionRepository;
{% if topic_summarization_enabled %}
import {{ base_package }}.ai.service.TopicSummarizationService;
{% endif %}
import lombok.extern.slf4j.Slf4j;
import org.springframework.scheduling.annotation.Scheduled;
import org.springframework.stereotype.Component;

import java.time.LocalDateTime;
import java.util.List;

/**
 * Scheduled cleanup of expired chat sessions and messages.
 *
 * <p>Req 4.10: Runs on cron {@code {{ cleanup_cron }}}, processes expired
 * sessions in batches of {{ batch_size }}.</p>
 * <p>Req 4.11: Sessions older than {{ default_ttl_days }} days (default TTL) are eligible.</p>
 * <p>Req 4.12: Processes up to {@code batchSize} sessions per run.</p>
 * <p>Req 4.13: Deletes messages first (FK), then session.</p>
 * <p>Req 4.14: Logs session count, deletion count, topics extracted, and duration.</p>
{% if topic_summarization_enabled %}
 * <p>Req 4.15: Invokes TopicSummarizationService before deletion.</p>
{% endif %}
 * <p>Req 4.19: On summarization failure, logs WARN and proceeds with deletion.</p>
 * <p>Req 4.25: All expired sessions processed are deleted (cleanup completeness).</p>
 *
 * Generated by SWFAW AI Layer generator.
 */
@Slf4j
@Component
public class ChatSessionCleanupScheduler {

    private final AiChatSessionRepository sessionRepository;
    private final AiChatMessageRepository messageRepository;
{% if topic_summarization_enabled %}
    private final TopicSummarizationService topicSummarizationService;
{% endif %}

    private static final int BATCH_SIZE = {{ batch_size }};
    private static final int DEFAULT_TTL_DAYS = {{ default_ttl_days }};

    public ChatSessionCleanupScheduler(
            AiChatSessionRepository sessionRepository,
{% if topic_summarization_enabled %}
            AiChatMessageRepository messageRepository,
            TopicSummarizationService topicSummarizationService) {
{% else %}
            AiChatMessageRepository messageRepository) {
{% endif %}
        this.sessionRepository = sessionRepository;
        this.messageRepository = messageRepository;
{% if topic_summarization_enabled %}
        this.topicSummarizationService = topicSummarizationService;
{% endif %}
    }

    /**
     * Cleanup expired chat sessions on the configured cron schedule.
     */
    @Scheduled(cron = "{{ cleanup_cron }}")
    public void cleanupExpiredSessions() {
        LocalDateTime cutoff = LocalDateTime.now().minusDays(DEFAULT_TTL_DAYS);
        log.info("Starting chat session cleanup for sessions older than {} (TTL {} days)",
                cutoff, DEFAULT_TTL_DAYS);

        long totalProcessed = 0;
        long totalDeleted = 0;
{% if topic_summarization_enabled %}
        long totalTopicsExtracted = 0;
{% endif %}
        long startTime = System.currentTimeMillis();

        try {
            var expiredSessions = sessionRepository
                    .findExpiredSessions(cutoff, BATCH_SIZE)
                    .collectList()
                    .block();

            if (expiredSessions == null || expiredSessions.isEmpty()) {
                log.info("No expired sessions found for cleanup");
                return;
            }

            totalProcessed = expiredSessions.size();

            for (var session : expiredSessions) {
{% if topic_summarization_enabled %}
                // Req 4.15: Extract topics before deletion
                try {
                    int topics = topicSummarizationService
                            .summarizeSession(session)
                            .block();
                    totalTopicsExtracted += topics;
                } catch (Exception e) {
                    // Req 4.19: Log and continue on summarization failure
                    log.warn("Topic summarization failed for session {}: {}",
                            session.getId(), e.getMessage());
                }
{% endif %}

                // Req 4.13: Delete messages first (FK cascade), then session
                try {
                    messageRepository.deleteBySessionId(session.getId()).block();
                    sessionRepository.deleteById(session.getId()).block();
                    totalDeleted++;
                } catch (Exception e) {
                    log.error("Failed to delete session {}: {}",
                            session.getId(), e.getMessage(), e);
                }
            }
        } catch (Exception e) {
            log.error("Error during chat session cleanup: {}", e.getMessage(), e);
        }

        long duration = System.currentTimeMillis() - startTime;
        // Req 4.14: Log summary
{% if topic_summarization_enabled %}
        log.info("Chat session cleanup completed: {} sessions processed, {} deleted, {} topics extracted in {} ms",
                totalProcessed, totalDeleted, totalTopicsExtracted, duration);
{% else %}
        log.info("Chat session cleanup completed: {} sessions processed, {} deleted in {} ms",
                totalProcessed, totalDeleted, duration);
{% endif %}
    }
}
