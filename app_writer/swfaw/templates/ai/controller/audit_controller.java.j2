package {{ base_package }}.ai.controller;

import {{ base_package }}.ai.dto.AiAuditEventDTO;
import {{ base_package }}.ai.dto.AiAuditPageDTO;
import {{ base_package }}.ai.dto.AiAuditStatsDTO;
import {{ base_package }}.ai.repository.AiAuditLogRepository;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.format.annotation.DateTimeFormat;
import org.springframework.security.access.prepost.PreAuthorize;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;
import reactor.core.publisher.Flux;
import reactor.core.publisher.Mono;

import java.time.LocalDateTime;

/**
 * Audit log REST controller exposing query endpoints for audit records.
 *
 * <p>Req 15.39: Base path {@code /api/ai/audit} with paginated listing,
 * stats, and per-user audit trail. All endpoints require JWT auth with admin role.</p>
 *
 * Generated by SWFAW AI Layer generator.
 */
@Slf4j
@RestController
@RequestMapping("/api/ai/audit")
@RequiredArgsConstructor
@PreAuthorize("hasRole('ADMIN')")
public class AiAuditController {

    private final AiAuditLogRepository auditLogRepository;

    /**
     * GET / — Paginated audit log with optional filters.
     */
    @GetMapping
    public Mono<AiAuditPageDTO> getAuditLog(
            @RequestParam(required = false) String eventType,
            @RequestParam(required = false) Long userId,
            @RequestParam(required = false) String providerName,
            @RequestParam(required = false) String status,
            @RequestParam(required = false) @DateTimeFormat(iso = DateTimeFormat.ISO.DATE_TIME) LocalDateTime dateFrom,
            @RequestParam(required = false) @DateTimeFormat(iso = DateTimeFormat.ISO.DATE_TIME) LocalDateTime dateTo,
            @RequestParam(defaultValue = "0") int page,
            @RequestParam(defaultValue = "20") int pageSize) {
        log.info("Fetching audit log (eventType={}, userId={}, provider={}, status={}, page={})",
                eventType, userId, providerName, status, page);
        return auditLogRepository
                .findByFilters(eventType, userId, providerName, status, dateFrom, dateTo,
                        pageSize, (long) page * pageSize)
                .map(entry -> AiAuditEventDTO.builder()
                        .id(entry.getId())
                        .eventType(entry.getEventType())
                        .userId(entry.getUserId())
                        .providerName(entry.getProviderName())
                        .operationName(entry.getOperationName())
                        .toolName(entry.getToolName())
                        .requestSummary(entry.getRequestSummary())
                        .responseSummary(entry.getResponseSummary())
                        .durationMs(entry.getDurationMs())
                        .status(entry.getStatus())
                        .details(entry.getDetails())
                        .ipAddress(entry.getIpAddress())
                        .createdAt(entry.getCreatedAt())
                        .build())
                .collectList()
                .zipWith(auditLogRepository.countByFilters(eventType, userId, providerName, status, dateFrom, dateTo))
                .map(tuple -> AiAuditPageDTO.builder()
                        .events(tuple.getT1())
                        .totalCount(tuple.getT2())
                        .page(page)
                        .pageSize(pageSize)
                        .build());
    }

    /**
     * GET /stats — Event counts by type and status for a date range.
     */
    @GetMapping("/stats")
    public Flux<AiAuditStatsDTO> getStats(
            @RequestParam(required = false) @DateTimeFormat(iso = DateTimeFormat.ISO.DATE_TIME) LocalDateTime dateFrom,
            @RequestParam(required = false) @DateTimeFormat(iso = DateTimeFormat.ISO.DATE_TIME) LocalDateTime dateTo) {
        log.info("Fetching audit stats (dateFrom={}, dateTo={})", dateFrom, dateTo);
        return auditLogRepository.getStatsByEventType(dateFrom, dateTo);
    }

    /**
     * GET /user/{userId} — Specific user's audit trail.
     */
    @GetMapping("/user/{userId}")
    public Flux<AiAuditEventDTO> getUserAuditTrail(@PathVariable Long userId) {
        log.info("Fetching audit trail for user {}", userId);
        return auditLogRepository.findByUserIdOrderByCreatedAtDesc(userId)
                .map(entry -> AiAuditEventDTO.builder()
                        .id(entry.getId())
                        .eventType(entry.getEventType())
                        .userId(entry.getUserId())
                        .providerName(entry.getProviderName())
                        .operationName(entry.getOperationName())
                        .toolName(entry.getToolName())
                        .requestSummary(entry.getRequestSummary())
                        .responseSummary(entry.getResponseSummary())
                        .durationMs(entry.getDurationMs())
                        .status(entry.getStatus())
                        .details(entry.getDetails())
                        .ipAddress(entry.getIpAddress())
                        .createdAt(entry.getCreatedAt())
                        .build());
    }
}
