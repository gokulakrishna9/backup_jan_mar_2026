                    return documentIngestionService.ingestFromRest(
                            bytes, filePart.filename(), mimeType, userId, Map.of());
                })
                .onErrorMap(IllegalArgumentException.class, e -> {
                    if (e.getMessage() != null && e.getMessage().contains("MIME type")) {
                        return new ResponseStatusException(HttpStatus.BAD_REQUEST, e.getMessage());
                    }
                    if (e.getMessage() != null && e.getMessage().contains("exceeds maximum")) {
                        return new ResponseStatusException(HttpStatus.PAYLOAD_TOO_LARGE, e.getMessage());
                    }
                    return new ResponseStatusException(HttpStatus.BAD_REQUEST, e.getMessage());
                });
