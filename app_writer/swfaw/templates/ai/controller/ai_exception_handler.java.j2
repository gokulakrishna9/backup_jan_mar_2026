        log.warn("Document too large: {}", ex.getMessage());
        Map<String, Object> details = new HashMap<>();
        details.put("fileSize", ex.getFileSize());
        details.put("maxSize", ex.getMaxSize());
        return buildResponse(HttpStatus.PAYLOAD_TOO_LARGE, "DOCUMENT_TOO_LARGE", ex.getMessage(), details);
    }

    // --- Req 14.20: McpServerException → 502 ---
    @ExceptionHandler(McpServerException.class)
