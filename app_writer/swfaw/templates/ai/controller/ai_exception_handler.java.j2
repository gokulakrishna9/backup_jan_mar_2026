        Map<String, Object> details = new HashMap<>();
        details.put("serverName", ex.getServerName());
        return buildResponse(HttpStatus.BAD_GATEWAY, "MCP_SERVER_ERROR", ex.getMessage(), details);
    }

    // --- Req 14.17: LLM provider errors → 502 ---
    @ExceptionHandler(WebClientResponseException.class)
    public ResponseEntity<AiErrorResponseDTO> handleLlmProviderError(WebClientResponseException ex) {
        log.error("LLM provider error: {} {}", ex.getStatusCode(), ex.getMessage());
        Map<String, Object> details = new HashMap<>();
        details.put("upstreamStatus", ex.getStatusCode().value());
        return buildResponse(HttpStatus.BAD_GATEWAY, "LLM_PROVIDER_ERROR", ex.getMessage(), details);
    }

    // --- Req 14.23: Catch-all → 500 ---
    @ExceptionHandler(Exception.class)
    public ResponseEntity<AiErrorResponseDTO> handleUnhandled(Exception ex) {
        log.error("Unhandled AI exception", ex);
        return buildResponse(HttpStatus.INTERNAL_SERVER_ERROR, "AI_INTERNAL_ERROR",
                "An unexpected error occurred in the AI subsystem.", null);
    }

    // --- Helper ---
    private ResponseEntity<AiErrorResponseDTO> buildResponse(
            HttpStatus status, String errorCode, String message, Map<String, Object> details) {
        AiErrorResponseDTO body = new AiErrorResponseDTO(errorCode, message, details, Instant.now().toString());
        return ResponseEntity.status(status).body(body);
    }
}
