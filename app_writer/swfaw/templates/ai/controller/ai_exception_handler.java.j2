/**
 * Centralized exception handler for all AI controllers.
 *
 * <p>Scoped to the {@code {{ base_package }}.ai} package via
 * {@code @ControllerAdvice(basePackages)}. Maps AI-specific exceptions
 * to consistent HTTP responses with {@link AiErrorResponseDTO}.</p>
 *
 * <p>Req 14.9: @ControllerAdvice scoped to ai package.</p>
 * <p>Req 14.25: Controllers throw typed exceptions; this handler maps them.</p>
 * <p>Req 14.26: All responses have non-null errorCode and message.</p>
 *
 * Generated by SWFAW AI Layer generator.
 */
@ControllerAdvice(basePackages = "{{ base_package }}.ai")
public class AiExceptionHandler {

    private static final Logger log = LoggerFactory.getLogger(AiExceptionHandler.class);

    // --- Req 14.11: UnsupportedRoleException → 400 ---
    @ExceptionHandler(UnsupportedRoleException.class)
    public ResponseEntity<AiErrorResponseDTO> handleUnsupportedRole(UnsupportedRoleException ex) {
        log.warn("Unsupported role: {}", ex.getMessage());
        Map<String, Object> details = new HashMap<>();
        details.put("unsupportedRole", ex.getUnsupportedRole());
        details.put("supportedRoles", ex.getSupportedRoles());
        return buildResponse(HttpStatus.BAD_REQUEST, "UNSUPPORTED_ROLE", ex.getMessage(), details);
    }

    // --- Req 14.12: UnsupportedParameterException → 400 ---
    @ExceptionHandler(UnsupportedParameterException.class)
    public ResponseEntity<AiErrorResponseDTO> handleUnsupportedParameter(UnsupportedParameterException ex) {
        log.warn("Unsupported parameter: {}", ex.getMessage());
        Map<String, Object> details = new HashMap<>();
        details.put("unsupportedParameter", ex.getUnsupportedParameter());
        details.put("supportedParameters", ex.getSupportedParameters());
        return buildResponse(HttpStatus.BAD_REQUEST, "UNSUPPORTED_PARAMETER", ex.getMessage(), details);
    }

    // --- Req 14.13: TypedResponseDeserializationException → 502 ---
    @ExceptionHandler(TypedResponseDeserializationException.class)
    public ResponseEntity<AiErrorResponseDTO> handleDeserializationError(TypedResponseDeserializationException ex) {
        log.error("LLM response deserialization failed: {}", ex.getMessage());
        return buildResponse(HttpStatus.BAD_GATEWAY, "LLM_RESPONSE_PARSE_ERROR", ex.getMessage(), null);
    }

    // --- Req 14.21: ProviderCircuitOpenException → 503 ---
    @ExceptionHandler(ProviderCircuitOpenException.class)
    public ResponseEntity<AiErrorResponseDTO> handleCircuitOpen(ProviderCircuitOpenException ex) {
        log.error("Provider circuit open: {}", ex.getMessage());
        Map<String, Object> details = new HashMap<>();
        details.put("providerName", ex.getProviderName());
        details.put("failureRate", ex.getFailureRate());
        return buildResponse(HttpStatus.SERVICE_UNAVAILABLE, "PROVIDER_CIRCUIT_OPEN", ex.getMessage(), details);
    }

    // --- Req 14.14: PromptSecurityViolationException → 422 ---
    @ExceptionHandler(PromptSecurityViolationException.class)
    public ResponseEntity<AiErrorResponseDTO> handlePromptSecurityViolation(PromptSecurityViolationException ex) {
        log.warn("Prompt security violation: {}", ex.getMessage());
        Map<String, Object> details = new HashMap<>();
        details.put("violationType", ex.getViolationType());
        return buildResponse(HttpStatus.UNPROCESSABLE_ENTITY, "PROMPT_SECURITY_VIOLATION", ex.getMessage(), details);
    }

    // --- Req 14.15: ModerationException → 422 ---
    @ExceptionHandler(ModerationException.class)
    public ResponseEntity<AiErrorResponseDTO> handleModeration(ModerationException ex) {
        log.warn("Content moderation blocked: {}", ex.getMessage());
        Map<String, Object> details = new HashMap<>();
        details.put("flaggedCategories", ex.getFlaggedCategories());
        details.put("action", ex.getAction());
        return buildResponse(HttpStatus.UNPROCESSABLE_ENTITY, "CONTENT_MODERATION_BLOCKED", ex.getMessage(), details);
    }

    // --- Req 14.22: TokenBudgetExceededException → 429 ---
    @ExceptionHandler(TokenBudgetExceededException.class)
    public ResponseEntity<AiErrorResponseDTO> handleTokenBudgetExceeded(TokenBudgetExceededException ex) {
        log.warn("Token budget exceeded: {}", ex.getMessage());
        Map<String, Object> details = new HashMap<>();
        details.put("providerName", ex.getProviderName());
        details.put("currentUsage", ex.getCurrentUsage());
        details.put("limit", ex.getLimit());
        details.put("period", ex.getPeriod());
        return buildResponse(HttpStatus.TOO_MANY_REQUESTS, "TOKEN_BUDGET_EXCEEDED", ex.getMessage(), details);
    }

    // --- Req 14.16: RateLimitExceededException → 429 ---
    @ExceptionHandler(RateLimitExceededException.class)
    public ResponseEntity<AiErrorResponseDTO> handleRateLimitExceeded(RateLimitExceededException ex) {
        log.warn("Rate limit exceeded: {}", ex.getMessage());
        return ResponseEntity.status(HttpStatus.TOO_MANY_REQUESTS)
                .header("Retry-After", String.valueOf(ex.getRetryAfterSeconds()))
                .body(new AiErrorResponseDTO("RATE_LIMIT_EXCEEDED", ex.getMessage(), null, Instant.now().toString()));
    }

    // --- Req 14.18: AccessDeniedException → 403 ---
    @ExceptionHandler(AccessDeniedException.class)
    public ResponseEntity<AiErrorResponseDTO> handleAccessDenied(AccessDeniedException ex) {
        log.warn("AI access denied: {}", ex.getMessage());
        return buildResponse(HttpStatus.FORBIDDEN, "AI_ACCESS_DENIED", ex.getMessage(), null);
    }

    // --- Req 14.19: InvalidDocumentTypeException → 400 ---
    @ExceptionHandler(InvalidDocumentTypeException.class)
    public ResponseEntity<AiErrorResponseDTO> handleInvalidDocumentType(InvalidDocumentTypeException ex) {
        log.warn("Invalid document type: {}", ex.getMessage());
        Map<String, Object> details = new HashMap<>();
        details.put("mimeType", ex.getMimeType());
        return buildResponse(HttpStatus.BAD_REQUEST, "INVALID_DOCUMENT_TYPE", ex.getMessage(), details);
    }

    // --- Req 14.19: DocumentTooLargeException → 413 ---
    @ExceptionHandler(DocumentTooLargeException.class)
