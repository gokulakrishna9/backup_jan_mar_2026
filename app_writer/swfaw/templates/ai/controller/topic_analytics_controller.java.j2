package {{ base_package }}.ai.controller;

import {{ base_package }}.ai.dto.GlobalTopicHitDTO;
import {{ base_package }}.ai.dto.TopicAnalyticsResponseDTO;
import {{ base_package }}.ai.dto.TopicDTO;
import {{ base_package }}.ai.dto.UserTopicHitDTO;
import {{ base_package }}.ai.repository.AiGlobalTopicHitRepository;
import {{ base_package }}.ai.repository.AiTopicRepository;
import {{ base_package }}.ai.repository.AiUserTopicHitRepository;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.security.access.prepost.PreAuthorize;
import org.springframework.security.core.annotation.AuthenticationPrincipal;
import org.springframework.security.oauth2.jwt.Jwt;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;
import reactor.core.publisher.Mono;

import java.util.List;

/**
 * Topic analytics REST controller exposing user, global, and admin endpoints.
 *
 * <p>Req 4.20: Base path {@code /api/ai/topics} with user topics,
 * global topics, and admin per-user topics. All endpoints require JWT auth.</p>
 *
 * Generated by SWFAW AI Layer generator.
 */
@Slf4j
@RestController
@RequestMapping("/api/ai/topics")
@RequiredArgsConstructor
public class TopicAnalyticsController {

    private final AiTopicRepository topicRepository;
    private final AiUserTopicHitRepository userTopicHitRepository;
    private final AiGlobalTopicHitRepository globalTopicHitRepository;

    /**
     * GET /user — Current user's topics sorted by hit count, paginated.
     */
    @GetMapping("/user")
    public Mono<TopicAnalyticsResponseDTO> getUserTopics(
            @AuthenticationPrincipal Jwt jwt,
            @RequestParam(defaultValue = "0") int page,
            @RequestParam(defaultValue = "20") int pageSize) {
        Long userId = Long.valueOf(jwt.getSubject());
        log.info("Fetching topics for user {} (page={}, pageSize={})", userId, page, pageSize);
        return userTopicHitRepository
                .findByUserIdOrderByHitCountDesc(userId, pageSize, (long) page * pageSize)
                .flatMap(hit -> topicRepository.findById(hit.getTopicId())
                        .map(topic -> UserTopicHitDTO.builder()
                                .topic(TopicDTO.builder()
                                        .id(topic.getId())
                                        .name(topic.getName())
                                        .createdAt(topic.getCreatedAt())
                                        .build())
                                .hitCount(hit.getHitCount())
                                .firstSeenAt(hit.getFirstSeenAt())
                                .lastSeenAt(hit.getLastSeenAt())
                                .build()))
                .collectList()
                .zipWith(userTopicHitRepository.countByUserId(userId))
                .map(tuple -> TopicAnalyticsResponseDTO.builder()
                        .topics(tuple.getT1())
                        .totalTopics(tuple.getT2())
                        .page(page)
                        .pageSize(pageSize)
                        .build());
    }

    /**
     * GET /global — Global topics sorted by global hit count, paginated.
     */
    @GetMapping("/global")
    public Mono<TopicAnalyticsResponseDTO> getGlobalTopics(
            @RequestParam(defaultValue = "0") int page,
            @RequestParam(defaultValue = "20") int pageSize) {
        log.info("Fetching global topics (page={}, pageSize={})", page, pageSize);
        return globalTopicHitRepository
                .findAllOrderByHitCountDesc(pageSize, (long) page * pageSize)
                .flatMap(hit -> topicRepository.findById(hit.getTopicId())
                        .map(topic -> (Object) GlobalTopicHitDTO.builder()
                                .topic(TopicDTO.builder()
                                        .id(topic.getId())
                                        .name(topic.getName())
                                        .createdAt(topic.getCreatedAt())
                                        .build())
                                .hitCount(hit.getHitCount())
                                .firstSeenAt(hit.getFirstSeenAt())
                                .lastSeenAt(hit.getLastSeenAt())
                                .build()))
                .collectList()
                .zipWith(globalTopicHitRepository.count())
                .map(tuple -> TopicAnalyticsResponseDTO.builder()
                        .topics(tuple.getT1())
                        .totalTopics(tuple.getT2())
                        .page(page)
                        .pageSize(pageSize)
                        .build());
    }

    /**
     * GET /admin/user/{userId} — Admin-only: specific user's topics.
     */
    @GetMapping("/admin/user/{userId}")
    @PreAuthorize("hasRole('ADMIN')")
    public Mono<TopicAnalyticsResponseDTO> getAdminUserTopics(
            @PathVariable Long userId,
            @RequestParam(defaultValue = "0") int page,
            @RequestParam(defaultValue = "20") int pageSize) {
        log.info("Admin fetching topics for user {} (page={}, pageSize={})", userId, page, pageSize);
        return userTopicHitRepository
                .findByUserIdOrderByHitCountDesc(userId, pageSize, (long) page * pageSize)
                .flatMap(hit -> topicRepository.findById(hit.getTopicId())
                        .map(topic -> UserTopicHitDTO.builder()
                                .topic(TopicDTO.builder()
                                        .id(topic.getId())
                                        .name(topic.getName())
                                        .createdAt(topic.getCreatedAt())
                                        .build())
                                .hitCount(hit.getHitCount())
                                .firstSeenAt(hit.getFirstSeenAt())
                                .lastSeenAt(hit.getLastSeenAt())
                                .build()))
                .collectList()
                .zipWith(userTopicHitRepository.countByUserId(userId))
                .map(tuple -> TopicAnalyticsResponseDTO.builder()
                        .topics(tuple.getT1())
                        .totalTopics(tuple.getT2())
                        .page(page)
                        .pageSize(pageSize)
                        .build());
    }
}
