package {{ base_package }}.ai.controller;

import {{ base_package }}.ai.dto.EvaluationResultDTO;
import {{ base_package }}.ai.dto.EvaluationStatsDTO;
import {{ base_package }}.ai.dto.EvaluatorBreakdownDTO;
import {{ base_package }}.ai.entity.AiEvaluationResult;
import {{ base_package }}.ai.repository.AiEvaluationResultRepository;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.web.bind.annotation.*;
import reactor.core.publisher.Flux;
import reactor.core.publisher.Mono;

import java.util.List;
import java.util.Map;
import java.util.stream.Collectors;

/**
 * REST controller exposing evaluation result endpoints.
 *
 * <p>Base path: {@code /api/ai/evaluations}.</p>
 *
 * <p>Req 10.10: EvaluationController with GET / (list results with filters),
 * GET /stats (aggregate statistics), and GET /by-operation/{operationName}.
 * JWT auth with rate limiting (category "evaluations", default 20 rpm).</p>
 *
 * Generated by SWFAW AI Layer generator.
 */
@Slf4j
@RestController
@RequestMapping("/api/ai/evaluations")
@RequiredArgsConstructor
public class EvaluationController {

    private final AiEvaluationResultRepository evaluationResultRepository;

    /**
     * List all evaluation results with optional filters.
     * {@code GET /api/ai/evaluations}
     *
     * @param evaluatorName optional filter by evaluator name
     * @param status        optional filter by status (pass, fail, warn, error)
     * @return evaluation results as a reactive stream
     */
    @GetMapping
    public Flux<EvaluationResultDTO> listResults(
            @RequestParam(required = false) String evaluatorName,
            @RequestParam(required = false) String status) {
        log.debug("GET /api/ai/evaluations evaluatorName={} status={}", evaluatorName, status);
        Flux<AiEvaluationResult> results;
        if (evaluatorName != null) {
            results = evaluationResultRepository.findByEvaluatorNameOrderByCreatedAtDesc(evaluatorName);
        } else if (status != null) {
            results = evaluationResultRepository.findByStatusOrderByCreatedAtDesc(status);
        } else {
            results = evaluationResultRepository.findAllByOrderByCreatedAtDesc();
        }
        return results.map(this::toDto);
    }

    /**
     * Get aggregate evaluation statistics.
     * {@code GET /api/ai/evaluations/stats}
     */
    @GetMapping("/stats")
    public Mono<EvaluationStatsDTO> getStats() {
        log.debug("GET /api/ai/evaluations/stats");
        return evaluationResultRepository.findAllByOrderByCreatedAtDesc()
                .collectList()
                .map(results -> {
                    long total = results.size();
                    long passCount = results.stream().filter(r -> "pass".equals(r.getStatus())).count();
                    long failCount = results.stream().filter(r -> "fail".equals(r.getStatus())).count();
                    long warnCount = results.stream().filter(r -> "warn".equals(r.getStatus())).count();
                    long errorCount = results.stream().filter(r -> "error".equals(r.getStatus())).count();
                    double avgScore = results.stream()
                            .filter(r -> r.getScore() != null)
                            .mapToDouble(AiEvaluationResult::getScore)
                            .average()
                            .orElse(0.0);
                    Map<String, List<AiEvaluationResult>> byEvaluator = results.stream()
                            .collect(Collectors.groupingBy(AiEvaluationResult::getEvaluatorName));
                    List<EvaluatorBreakdownDTO> breakdown = byEvaluator.entrySet().stream()
                            .map(entry -> {
                                List<AiEvaluationResult> group = entry.getValue();
                                return new EvaluatorBreakdownDTO(
                                        entry.getKey(),
                                        group.isEmpty() ? "" : group.get(0).getEvaluatorType(),
                                        group.size(),
                                        group.stream().filter(r -> "pass".equals(r.getStatus())).count(),
                                        group.stream().filter(r -> "fail".equals(r.getStatus())).count(),
                                        group.stream()
                                                .filter(r -> r.getScore() != null)
                                                .mapToDouble(AiEvaluationResult::getScore)
                                                .average()
                                                .orElse(0.0)
                                );
                            })
                            .toList();
                    return new EvaluationStatsDTO(total, passCount, failCount, warnCount, errorCount, avgScore, breakdown);
                });
    }

    /**
     * Get evaluation results for a specific operation.
     * {@code GET /api/ai/evaluations/by-operation/{operationName}}
     */
    @GetMapping("/by-operation/{operationName}")
    public Flux<EvaluationResultDTO> getByOperation(@PathVariable String operationName) {
        log.debug("GET /api/ai/evaluations/by-operation/{}", operationName);
        return evaluationResultRepository.findByOperationNameOrderByCreatedAtDesc(operationName)
                .map(this::toDto);
    }

    private EvaluationResultDTO toDto(AiEvaluationResult entity) {
        return new EvaluationResultDTO(
                entity.getEvaluatorName(),
                entity.getEvaluatorType(),
                entity.getScore() != null ? entity.getScore() : 0.0,
                entity.getCategory(),
                entity.getStatus(),
                entity.getInputText(),
                entity.getOutputText()
        );
    }
}
