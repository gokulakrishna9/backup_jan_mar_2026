package {{ base_package }}.ai.dto;

import lombok.AllArgsConstructor;
import lombok.Builder;
import lombok.Data;
import lombok.NoArgsConstructor;

/**
 * Generic wrapper for typed AI response results.
 *
 * <p>Wraps the deserialized result with metadata about success/failure,
 * the raw LLM response, and any error information.</p>
 *
 * <p>Req 7.9: When fallbackBehavior is "raw_string", success=false and
 *    rawResponse contains the original LLM text.</p>
 * <p>Req 7.10: When fallbackBehavior is "default_object", success=false and
 *    data contains a default-constructed instance.</p>
 * <p>Req 7.14: Generated as part of standard AI generation.</p>
 *
 * Generated by SWFAW AI Layer generator.
 *
 * @param <T> the expected response type
 */
@Data
@Builder
@NoArgsConstructor
@AllArgsConstructor
public class TypedResponseResult<T> {

    /**
     * Whether deserialization succeeded.
     */
    private boolean success;

    /**
     * The deserialized data (null on failure unless fallback is "default_object").
     */
    private T data;

    /**
     * The raw LLM response string (populated on failure when fallback is "raw_string").
     */
    private String rawResponse;

    /**
     * Error message when deserialization fails (null on success).
     */
    private String error;

    /**
     * Create a successful result wrapping the deserialized data.
     */
    public static <T> TypedResponseResult<T> success(T data) {
        return TypedResponseResult.<T>builder()
                .success(true)
                .data(data)
                .build();
    }

    /**
     * Create a failed result with the raw response (fallback: "raw_string").
     */
    public static <T> TypedResponseResult<T> rawStringFallback(String rawResponse, String error) {
        return TypedResponseResult.<T>builder()
                .success(false)
                .rawResponse(rawResponse)
                .error(error)
                .build();
    }

    /**
     * Create a failed result with a default object (fallback: "default_object").
     */
    public static <T> TypedResponseResult<T> defaultObjectFallback(T defaultInstance, String rawResponse, String error) {
        return TypedResponseResult.<T>builder()
                .success(false)
                .data(defaultInstance)
                .rawResponse(rawResponse)
                .error(error)
                .build();
    }
}
