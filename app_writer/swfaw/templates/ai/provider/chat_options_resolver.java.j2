package {{ base_package }}.ai.provider;

{% for provider in providers %}
{% if provider.type == 'openai' %}
import org.springframework.ai.openai.OpenAiChatOptions;
{% elif provider.type == 'ollama' %}
import org.springframework.ai.ollama.api.OllamaOptions;
{% endif %}
{% endfor %}
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Component;
import lombok.extern.slf4j.Slf4j;

import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.Set;

/**
 * Resolves and validates Chat_Options parameters against each provider's
 * supportedParameters and parameterFallbacks configuration.
 *
 * Ensures only supported parameters reach the external LLM service.
 * Generated by SWFAW AI Layer generator.
 */
@Slf4j
@Component
public class ChatOptionsResolver {

    /** Maps provider name → set of supported parameter names. */
    private final Map<String, Set<String>> supportedParametersByProvider = new HashMap<>();

    /** Maps provider name → (parameter name → fallback action). */
    private final Map<String, Map<String, String>> parameterFallbacksByProvider = new HashMap<>();

    /** Maps provider name → provider type ("openai" or "ollama"). */
    private final Map<String, String> providerTypes = new HashMap<>();

    public ChatOptionsResolver(
{% for provider in providers %}
            @Value("${ai.providers.{{ provider.name }}.supported-parameters:{{ provider.supportedParameters | default([]) | join(',') }}}") List<String> {{ provider.name }}SupportedParams{{ "," if not loop.last else "" }}
{% endfor %}
    ) {
{% for provider in providers %}
        this.providerTypes.put("{{ provider.name }}", "{{ provider.type }}");
        this.supportedParametersByProvider.put("{{ provider.name }}",
                {{ provider.name }}SupportedParams.isEmpty() ? Set.of() : Set.copyOf({{ provider.name }}SupportedParams));
{% if provider.parameterFallbacks %}
        this.parameterFallbacksByProvider.put("{{ provider.name }}", Map.of(
{% for param, action in provider.parameterFallbacks.items() %}
                "{{ param }}", "{{ action }}"{{ "," if not loop.last else "" }}
{% endfor %}
        ));
{% else %}
        this.parameterFallbacksByProvider.put("{{ provider.name }}", Map.of());
{% endif %}
{% endfor %}
    }

    /**
     * Resolve chat options for a given provider, filtering out unsupported parameters.
     *
     * @param providerName the provider name
     * @param chatOptions  the raw chat options map (parameter name → value)
     * @return a filtered map containing only supported parameters
     * @throws UnsupportedParameterException when a parameter has fallback "error"
     */
    public Map<String, Object> resolve(String providerName, Map<String, Object> chatOptions) {
        if (chatOptions == null || chatOptions.isEmpty()) {
            return Map.of();
        }

        Set<String> supported = supportedParametersByProvider.getOrDefault(providerName, Set.of());
        Map<String, String> fallbacks = parameterFallbacksByProvider.getOrDefault(providerName, Map.of());

        if (supported.isEmpty()) {
            log.warn("Provider '{}' has empty supportedParameters — skipping all chat options", providerName);
            return Map.of();
        }

        Map<String, Object> resolved = new HashMap<>();
        for (Map.Entry<String, Object> entry : chatOptions.entrySet()) {
            String param = entry.getKey();
            if (supported.contains(param)) {
                resolved.put(param, entry.getValue());
            } else {
                String fallback = fallbacks.getOrDefault(param, "skip");
                if ("error".equals(fallback)) {
                    throw new UnsupportedParameterException(providerName, param, supported);
                }
                // default: skip
                log.warn("Provider '{}': unsupported parameter '{}' skipped (fallback=skip)", providerName, param);
            }
        }
        return resolved;
    }

    /**
     * Build provider-specific ChatOptions from the resolved parameter map.
     *
     * @param providerName the provider name
     * @param resolvedOptions the resolved (filtered) options map
     * @return a Spring AI options object for the provider type
     */
    public Object buildChatOptions(String providerName, Map<String, Object> resolvedOptions) {
        String type = providerTypes.getOrDefault(providerName, "openai");
        if ("ollama".equals(type)) {
            return buildOllamaOptions(resolvedOptions);
        }
        return buildOpenAiOptions(resolvedOptions);
    }

    private OpenAiChatOptions buildOpenAiOptions(Map<String, Object> opts) {
        var builder = OpenAiChatOptions.builder();
        if (opts.containsKey("topP")) builder.topP(toDouble(opts.get("topP")));
        if (opts.containsKey("frequencyPenalty")) builder.frequencyPenalty(toDouble(opts.get("frequencyPenalty")));
        if (opts.containsKey("presencePenalty")) builder.presencePenalty(toDouble(opts.get("presencePenalty")));
        if (opts.containsKey("seed")) builder.seed(toInt(opts.get("seed")));
        if (opts.containsKey("stop")) {
            @SuppressWarnings("unchecked")
            List<String> stops = (List<String>) opts.get("stop");
            builder.stop(stops);
        }
        return builder.build();
    }

    private OllamaOptions buildOllamaOptions(Map<String, Object> opts) {
        var builder = OllamaOptions.builder();
        if (opts.containsKey("topP")) builder.topP(toDouble(opts.get("topP")));
        if (opts.containsKey("topK")) builder.topK(toInt(opts.get("topK")));
        if (opts.containsKey("repeatPenalty")) builder.repeatPenalty(toDouble(opts.get("repeatPenalty")));
        if (opts.containsKey("seed")) builder.seed(toInt(opts.get("seed")));
        if (opts.containsKey("numCtx")) builder.numCtx(toInt(opts.get("numCtx")));
        if (opts.containsKey("numPredict")) builder.numPredict(toInt(opts.get("numPredict")));
        if (opts.containsKey("mirostat")) builder.mirostat(toInt(opts.get("mirostat")));
        if (opts.containsKey("mirostatTau")) builder.mirostatTau(toDouble(opts.get("mirostatTau")));
        if (opts.containsKey("mirostatEta")) builder.mirostatEta(toDouble(opts.get("mirostatEta")));
        if (opts.containsKey("tfsZ")) builder.tfsZ(toDouble(opts.get("tfsZ")));
        if (opts.containsKey("stop")) {
            @SuppressWarnings("unchecked")
            List<String> stops = (List<String>) opts.get("stop");
            builder.stop(stops);
        }
        return builder.build();
    }

    private double toDouble(Object val) {
        return val instanceof Number n ? n.doubleValue() : Double.parseDouble(String.valueOf(val));
    }

    private int toInt(Object val) {
        return val instanceof Number n ? n.intValue() : Integer.parseInt(String.valueOf(val));
    }
}
