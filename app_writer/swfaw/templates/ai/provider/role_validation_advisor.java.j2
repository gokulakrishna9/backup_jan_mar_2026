package {{ base_package }}.ai.provider;

import org.springframework.ai.chat.messages.AssistantMessage;
import org.springframework.ai.chat.messages.Message;
import org.springframework.ai.chat.messages.SystemMessage;
import org.springframework.ai.chat.messages.UserMessage;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Component;
import lombok.extern.slf4j.Slf4j;

import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.Set;

/**
 * Validates message roles against each provider's supportedRoles and applies
 * roleFallbacks before the ChatClient call.
 *
 * Operates on a defensive copy of the message list so the original is never mutated.
 * Generated by SWFAW AI Layer generator.
 */
@Slf4j
@Component
public class RoleValidationAdvisor {

    /** Maps provider name → set of supported roles. */
    private final Map<String, Set<String>> supportedRolesByProvider = new HashMap<>();

    /** Maps provider name → (role → fallback action). */
    private final Map<String, Map<String, String>> roleFallbacksByProvider = new HashMap<>();

    public RoleValidationAdvisor(
{% for provider in providers %}
            @Value("${ai.providers.{{ provider.name }}.supported-roles:{{ provider.supportedRoles | default(['system', 'user', 'assistant']) | join(',') }}}") List<String> {{ provider.name }}SupportedRoles{{ "," if not loop.last else "" }}
{% endfor %}
    ) {
{% for provider in providers %}
        this.supportedRolesByProvider.put("{{ provider.name }}",
                {{ provider.name }}SupportedRoles.isEmpty() ? Set.of("system", "user", "assistant") : Set.copyOf({{ provider.name }}SupportedRoles));
{% if provider.roleFallbacks %}
        this.roleFallbacksByProvider.put("{{ provider.name }}", Map.of(
{% for role, action in provider.roleFallbacks.items() %}
                "{{ role }}", "{{ action }}"{{ "," if not loop.last else "" }}
{% endfor %}
        ));
{% else %}
        this.roleFallbacksByProvider.put("{{ provider.name }}", Map.of());
{% endif %}
{% endfor %}
    }

    /**
     * Validate and transform messages for the given provider.
     *
     * @param providerName the provider name
     * @param messages     the original message list (not mutated)
     * @return a new list with only supported roles after fallback processing
     * @throws UnsupportedRoleException when a role has fallback "error" or no fallback
     */
    public List<Message> validate(String providerName, List<Message> messages) {
        Set<String> supported = supportedRolesByProvider.getOrDefault(
                providerName, Set.of("system", "user", "assistant"));
        Map<String, String> fallbacks = roleFallbacksByProvider.getOrDefault(providerName, Map.of());

        // Defensive copy
        List<Message> result = new ArrayList<>();
        StringBuilder prependBuffer = new StringBuilder();
        StringBuilder mergeToSystemBuffer = new StringBuilder();

        for (Message msg : messages) {
            String role = msg.getMessageType().getValue();
            if (supported.contains(role)) {
                result.add(msg);
                continue;
            }

            String fallback = fallbacks.get(role);
            if (fallback == null || "error".equals(fallback)) {
                throw new UnsupportedRoleException(providerName, role, supported);
            }

            String content = msg.getText();
            switch (fallback) {
                case "prepend_to_user" -> {
                    log.debug("Provider '{}': role '{}' → prepend_to_user", providerName, role);
                    prependBuffer.append(content).append("\n");
                }
                case "skip" -> {
                    log.debug("Provider '{}': role '{}' → skip", providerName, role);
                    // message dropped
                }
                case "merge_to_system" -> {
                    log.debug("Provider '{}': role '{}' → merge_to_system", providerName, role);
                    mergeToSystemBuffer.append(content).append("\n");
                }
                default -> throw new UnsupportedRoleException(providerName, role, supported);
            }
        }

        // Apply prepend_to_user: merge into the first user message
        if (!prependBuffer.isEmpty()) {
            boolean merged = false;
            for (int i = 0; i < result.size(); i++) {
                if ("user".equals(result.get(i).getMessageType().getValue())) {
                    String combined = prependBuffer.toString().trim() + "\n" + result.get(i).getText();
                    result.set(i, new UserMessage(combined));
                    merged = true;
                    break;
                }
            }
            if (!merged) {
                // No user message found — add as a new user message
                result.add(new UserMessage(prependBuffer.toString().trim()));
            }
        }

        // Apply merge_to_system: append to the first system message
        if (!mergeToSystemBuffer.isEmpty()) {
            boolean merged = false;
            for (int i = 0; i < result.size(); i++) {
                if ("system".equals(result.get(i).getMessageType().getValue())) {
                    String combined = result.get(i).getText() + "\n" + mergeToSystemBuffer.toString().trim();
                    result.set(i, new SystemMessage(combined));
                    merged = true;
                    break;
                }
            }
            if (!merged) {
                // No system message found — add as a new system message at the start
                result.addFirst(new SystemMessage(mergeToSystemBuffer.toString().trim()));
            }
        }

        return result;
    }
}
