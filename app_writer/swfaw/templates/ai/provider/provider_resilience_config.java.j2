package {{ base_package }}.ai.provider;

import io.github.resilience4j.circuitbreaker.CircuitBreaker;
import io.github.resilience4j.circuitbreaker.CircuitBreakerConfig;
import io.github.resilience4j.circuitbreaker.CircuitBreakerRegistry;
import io.github.resilience4j.retry.Retry;
import io.github.resilience4j.retry.RetryConfig;
import io.github.resilience4j.retry.RetryRegistry;
import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import lombok.extern.slf4j.Slf4j;

import java.time.Duration;
import java.util.Set;

/**
 * Resilience4j retry and circuit breaker configuration for AI providers.
 *
 * Each provider gets its own Retry and CircuitBreaker instances that decorate
 * ChatClient and EmbeddingModel calls for graceful degradation.
 * Generated by SWFAW AI Layer generator.
 */
@Slf4j
@Configuration
public class ProviderResilienceConfig {
{% for provider in providers %}
{% set res = provider.resilience | default({}) %}
{% set retry = res.retry | default({}) %}
{% set cb = res.circuitBreaker | default({}) %}

    // --- {{ provider.name }} Retry ---

    @Value("${ai.providers.{{ provider.name }}.resilience.retry.max-attempts:{{ retry.maxAttempts | default(3) }}}")
    private int {{ provider.name }}RetryMaxAttempts;

    @Value("${ai.providers.{{ provider.name }}.resilience.retry.backoff-ms:{{ retry.backoffMs | default(1000) }}}")
    private long {{ provider.name }}RetryBackoffMs;

    @Value("${ai.providers.{{ provider.name }}.resilience.retry.retry-on-timeout:{{ retry.retryOnTimeout | default(true) | lower }}}")
    private boolean {{ provider.name }}RetryOnTimeout;

    @Bean
    @Qualifier("{{ provider.name }}")
    public Retry {{ provider.name }}Retry() {
        Set<Integer> retryableStatuses = Set.of({{ (retry.retryableStatuses | default([429, 503])) | join(', ') }});

        RetryConfig config = RetryConfig.custom()
                .maxAttempts({{ provider.name }}RetryMaxAttempts)
                .waitDuration(Duration.ofMillis({{ provider.name }}RetryBackoffMs))
                .intervalFunction(attempt -> {{ provider.name }}RetryBackoffMs * (long) Math.pow(2, attempt - 1))
                .retryOnException(ex -> {
                    if ({{ provider.name }}RetryOnTimeout && isTimeoutException(ex)) {
                        return true;
                    }
                    return isRetryableStatus(ex, retryableStatuses);
                })
                .build();

        Retry retry = RetryRegistry.of(config).retry("ai-retry-{{ provider.name }}");
        retry.getEventPublisher().onRetry(event ->
                log.warn("Provider '{{ provider.name }}': retry attempt {} due to: {}",
                        event.getNumberOfRetryAttempts(), event.getLastThrowable().getMessage()));
        return retry;
    }

    // --- {{ provider.name }} Circuit Breaker ---

    @Value("${ai.providers.{{ provider.name }}.resilience.circuit-breaker.failure-rate-threshold:{{ cb.failureRateThreshold | default(50) }}}")
    private int {{ provider.name }}CbFailureRateThreshold;

    @Value("${ai.providers.{{ provider.name }}.resilience.circuit-breaker.wait-duration-ms:{{ cb.waitDurationMs | default(30000) }}}")
    private long {{ provider.name }}CbWaitDurationMs;

    @Value("${ai.providers.{{ provider.name }}.resilience.circuit-breaker.sliding-window-size:{{ cb.slidingWindowSize | default(10) }}}")
    private int {{ provider.name }}CbSlidingWindowSize;

    @Value("${ai.providers.{{ provider.name }}.resilience.circuit-breaker.minimum-number-of-calls:{{ cb.minimumNumberOfCalls | default(5) }}}")
    private int {{ provider.name }}CbMinimumCalls;

    @Bean
    @Qualifier("{{ provider.name }}")
    public CircuitBreaker {{ provider.name }}CircuitBreaker() {
        CircuitBreakerConfig config = CircuitBreakerConfig.custom()
                .failureRateThreshold({{ provider.name }}CbFailureRateThreshold)
                .waitDurationInOpenState(Duration.ofMillis({{ provider.name }}CbWaitDurationMs))
                .slidingWindowSize({{ provider.name }}CbSlidingWindowSize)
                .minimumNumberOfCalls({{ provider.name }}CbMinimumCalls)
                .build();

        CircuitBreaker cb = CircuitBreakerRegistry.of(config).circuitBreaker("ai-cb-{{ provider.name }}");
        cb.getEventPublisher()
                .onStateTransition(event -> {
                    if (event.getStateTransition().getToState() == CircuitBreaker.State.OPEN) {
                        log.error("Provider '{{ provider.name }}': circuit breaker OPEN — failure rate: {}%",
                                cb.getMetrics().getFailureRate());
                    } else {
                        log.info("Provider '{{ provider.name }}': circuit breaker state → {}",
                                event.getStateTransition().getToState());
                    }
                });
        return cb;
    }
{% endfor %}

    // --- Utility methods ---

    private boolean isTimeoutException(Throwable ex) {
        return ex instanceof java.util.concurrent.TimeoutException
                || ex instanceof java.net.SocketTimeoutException
                || (ex.getCause() != null && isTimeoutException(ex.getCause()));
    }

    private boolean isRetryableStatus(Throwable ex, Set<Integer> retryableStatuses) {
        // Check for Spring WebClient response status exceptions
        if (ex instanceof org.springframework.web.reactive.function.client.WebClientResponseException wcre) {
            return retryableStatuses.contains(wcre.getStatusCode().value());
        }
        if (ex.getCause() != null) {
            return isRetryableStatus(ex.getCause(), retryableStatuses);
        }
        return false;
    }
}
