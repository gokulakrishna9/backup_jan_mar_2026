package {{ base_package }}.ai.provider;

import java.util.Set;

/**
 * Thrown when a message role is not supported by the provider
 * and no fallback strategy is configured.
 * Generated by SWFAW AI Layer generator.
 */
public class UnsupportedRoleException extends RuntimeException {

    private final String providerName;
    private final String unsupportedRole;
    private final Set<String> supportedRoles;

    public UnsupportedRoleException(String providerName, String unsupportedRole, Set<String> supportedRoles) {
        super(String.format("Provider '%s' does not support role '%s'. Supported roles: %s",
                providerName, unsupportedRole, supportedRoles));
        this.providerName = providerName;
        this.unsupportedRole = unsupportedRole;
        this.supportedRoles = supportedRoles;
    }

    public String getProviderName() { return providerName; }
    public String getUnsupportedRole() { return unsupportedRole; }
    public Set<String> getSupportedRoles() { return supportedRoles; }
}
