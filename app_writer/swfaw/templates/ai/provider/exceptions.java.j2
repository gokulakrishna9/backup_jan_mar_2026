package {{ base_package }}.ai.provider;

/**
 * Thrown when the LLM response cannot be deserialized into the expected type.
 * Generated by SWFAW AI Layer generator.
 */
public class TypedResponseDeserializationException extends RuntimeException {

    private final String expectedType;
    private final String rawResponse;

    public TypedResponseDeserializationException(String expectedType, String rawResponse, Throwable cause) {
        super(String.format("Failed to deserialize LLM response to type '%s': %s",
                expectedType, cause.getMessage()), cause);
        this.expectedType = expectedType;
        this.rawResponse = rawResponse;
    }

    public String getExpectedType() { return expectedType; }
    public String getRawResponse() { return rawResponse; }
}
