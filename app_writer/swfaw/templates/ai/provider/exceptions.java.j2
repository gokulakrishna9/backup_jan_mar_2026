package {{ base_package }}.ai.provider;

/**
 * Thrown when a provider's circuit breaker is in OPEN state,
 * indicating the provider is consistently failing.
 * Generated by SWFAW AI Layer generator.
 */
public class ProviderCircuitOpenException extends RuntimeException {

    private final String providerName;
    private final float failureRate;

    public ProviderCircuitOpenException(String providerName, float failureRate) {
        super(String.format("Provider '%s' circuit breaker is OPEN (failure rate: %.1f%%). Requests are being rejected.",
                providerName, failureRate));
        this.providerName = providerName;
        this.failureRate = failureRate;
    }

    public String getProviderName() { return providerName; }
    public float getFailureRate() { return failureRate; }
}
