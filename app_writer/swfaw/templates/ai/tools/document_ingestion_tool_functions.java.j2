package {{ base_package }}.ai.tools;

import {{ base_package }}.ai.ingestion.DocumentIngestionService;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.ai.tool.annotation.Tool;
import org.springframework.ai.tool.annotation.ToolParam;
import org.springframework.security.core.Authentication;
import org.springframework.stereotype.Component;

/**
 * Tool functions wrapping document ingestion operations for the orchestrator.
 *
 * <p>Req 13.1: DocumentIngestionToolFunctions with re-extract operation.</p>
 *
 * <p>Req 13.2: All methods use @Tool/@ToolParam annotations, return String.</p>
 *
 * <p>Req 13.10: Enforces authorization — verifies document ownership.</p>
 *
 * Generated by SWFAW AI Layer generator.
 */
@Slf4j
@Component
@RequiredArgsConstructor
public class DocumentIngestionToolFunctions {

    private final DocumentIngestionService documentIngestionService;

    private static final String ACCESS_DENIED = "Access denied: you do not have permission to perform document ingestion operations.";

    /**
     * Re-extract text from an ingested document.
     *
     * @param documentId the document ID to re-extract
     * @return result message as a String
     */
    @Tool(description = "Re-extract text from an ingested document")
    public String reExtractDocument(
            @ToolParam(description = "The document ID to re-extract text from") Long documentId) {
        Authentication auth = ToolSecurityContextHolder.getAuthentication();
        if (auth == null || !auth.isAuthenticated()) {
            return ACCESS_DENIED;
        }
        try {
            log.info("Tool: reExtractDocument id={} invoked by user={}", documentId, auth.getName());
            Long userId = extractUserId(auth);
            return documentIngestionService.reExtract(documentId, userId)
                    .map(doc -> "Successfully re-extracted document: " + doc.filename())
                    .block();
        } catch (Exception e) {
            log.error("Tool reExtractDocument failed: {}", e.getMessage());
            return "Error re-extracting document " + documentId + ": " + e.getMessage();
        }
    }

    /**
     * List ingested documents for the current user.
     *
     * @return list of documents as a String
     */
    @Tool(description = "List ingested documents for the current user")
    public String listIngestedDocuments() {
        Authentication auth = ToolSecurityContextHolder.getAuthentication();
        if (auth == null || !auth.isAuthenticated()) {
            return ACCESS_DENIED;
        }
        try {
            log.info("Tool: listIngestedDocuments invoked by user={}", auth.getName());
            Long userId = extractUserId(auth);
            return documentIngestionService.listDocuments(userId)
                    .map(doc -> doc.id() + ": " + doc.filename() + " (" + doc.mimeType() + ")")
                    .collectList()
                    .map(list -> list.isEmpty() ? "No documents found." : String.join("\n", list))
                    .block();
        } catch (Exception e) {
            log.error("Tool listIngestedDocuments failed: {}", e.getMessage());
            return "Error listing documents: " + e.getMessage();
        }
    }

    private Long extractUserId(Authentication auth) {
        try {
            return Long.parseLong(auth.getName());
        } catch (NumberFormatException e) {
            return 0L;
        }
    }
}
