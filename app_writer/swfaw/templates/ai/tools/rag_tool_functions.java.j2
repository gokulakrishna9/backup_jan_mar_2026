package {{ base_package }}.ai.tools;

import {{ base_package }}.ai.rag.RagIndexingService;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.ai.tool.annotation.Tool;
import org.springframework.ai.tool.annotation.ToolParam;
import org.springframework.security.core.Authentication;
import org.springframework.security.core.GrantedAuthority;
import org.springframework.stereotype.Component;

/**
 * Tool functions wrapping RAG indexing operations for the orchestrator.
 *
 * <p>Req 13.1: RagToolFunctions with reindex and index-document operations.</p>
 *
 * <p>Req 13.2: All methods use @Tool/@ToolParam annotations, return String.</p>
 *
 * <p>Req 13.10: Enforces admin permissions for RAG operations.</p>
 *
 * Generated by SWFAW AI Layer generator.
 */
@Slf4j
@Component
@RequiredArgsConstructor
public class RagToolFunctions {

    private final RagIndexingService ragIndexingService;

    private static final String ACCESS_DENIED = "Access denied: RAG indexing operations require admin permissions.";

    /**
     * Reindex a RAG source.
     *
     * @param sourceName the RAG source name to reindex
     * @return result message as a String
     */
    @Tool(description = "Reindex a RAG source by name (admin only)")
    public String reindexRagSource(
            @ToolParam(description = "The RAG source name to reindex") String sourceName) {
        Authentication auth = ToolSecurityContextHolder.getAuthentication();
        if (!isAdmin(auth)) {
            return ACCESS_DENIED;
        }
        try {
            log.info("Tool: reindexRagSource '{}' invoked by user={}", sourceName, auth.getName());
            ragIndexingService.reindexSource(sourceName).block();
            return "Successfully reindexed RAG source: " + sourceName;
        } catch (Exception e) {
            log.error("Tool reindexRagSource failed: {}", e.getMessage());
            return "Error reindexing RAG source " + sourceName + ": " + e.getMessage();
        }
    }

    /**
     * Index a specific document into a RAG source.
     *
     * @param sourceName the RAG source name
     * @param entityType the entity type
     * @param entityId   the entity ID
     * @param fieldName  the field name to index
     * @param text       the text content to index
     * @return result message as a String
     */
    @Tool(description = "Index a document into a RAG source (admin only)")
    public String indexDocumentInRagSource(
            @ToolParam(description = "The RAG source name") String sourceName,
            @ToolParam(description = "The entity type") String entityType,
            @ToolParam(description = "The entity ID") Long entityId,
            @ToolParam(description = "The field name to index") String fieldName,
            @ToolParam(description = "The text content to index") String text) {
        Authentication auth = ToolSecurityContextHolder.getAuthentication();
        if (!isAdmin(auth)) {
            return ACCESS_DENIED;
        }
        try {
            log.info("Tool: indexDocumentInRagSource '{}' entity={}/{} invoked by user={}",
                    sourceName, entityType, entityId, auth.getName());
            ragIndexingService.indexEntity(sourceName, entityType, entityId, fieldName, text).block();
            return "Successfully indexed document into RAG source: " + sourceName;
        } catch (Exception e) {
            log.error("Tool indexDocumentInRagSource failed: {}", e.getMessage());
            return "Error indexing document into RAG source " + sourceName + ": " + e.getMessage();
        }
    }

    private boolean isAdmin(Authentication auth) {
        if (auth == null || !auth.isAuthenticated()) {
            return false;
        }
        return auth.getAuthorities().stream()
                .map(GrantedAuthority::getAuthority)
                .anyMatch(role -> role.equals("ROLE_ADMIN") || role.equals("ADMIN"));
    }
}
