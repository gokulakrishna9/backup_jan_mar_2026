{
  "name": "Password",
  "import": "Password",
  "category": "Form",
  "metadata": {
    "description": "Password input with strength meter",
    "usageExamples": [
      "<PasswordWrapper value={password} onChange={(e) => setPassword(e.target.value)} />",
      "<PasswordWrapper value={pwd} feedback={false} toggleMask />"
    ]
  },
  "propsInterface": {
    "componentSpecific": [
      {
        "name": "value",
        "type": "string",
        "optional": true,
        "description": "Password value",
        "helpText": "Current password (controlled component)",
        "dataTypes": ["string"],
        "examples": ["password", "'mypassword'"]
      },
      {
        "name": "feedback",
        "type": "boolean",
        "optional": true,
        "description": "Show strength meter",
        "helpText": "Displays password strength indicator",
        "dataTypes": ["boolean (default: true)"],
        "examples": ["true", "false"]
      },
      {
        "name": "toggleMask",
        "type": "boolean",
        "optional": true,
        "description": "Show/hide toggle",
        "helpText": "Eye icon to reveal password",
        "dataTypes": ["boolean"],
        "examples": ["true", "false"]
      },
      {
        "name": "placeholder",
        "type": "string",
        "optional": true,
        "description": "Placeholder text",
        "helpText": "Text shown when empty",
        "dataTypes": ["string"],
        "examples": ["'Enter password'", "'Password'"]
      },
      {
        "name": "disabled",
        "type": "boolean",
        "optional": true,
        "description": "Disabled state",
        "helpText": "Disables the input",
        "dataTypes": ["boolean"],
        "examples": ["true", "false"]
      },
      {
        "name": "promptLabel",
        "type": "string",
        "optional": true,
        "description": "Prompt label",
        "helpText": "Label for password prompt",
        "dataTypes": ["string"],
        "examples": ["'Enter a password'"]
      },
      {
        "name": "weakLabel",
        "type": "string",
        "optional": true,
        "description": "Weak strength label",
        "helpText": "Text for weak password",
        "dataTypes": ["string"],
        "examples": ["'Weak'", "'Too weak'"]
      },
      {
        "name": "mediumLabel",
        "type": "string",
        "optional": true,
        "description": "Medium strength label",
        "helpText": "Text for medium password",
        "dataTypes": ["string"],
        "examples": ["'Medium'", "'Average'"]
      },
      {
        "name": "strongLabel",
        "type": "string",
        "optional": true,
        "description": "Strong strength label",
        "helpText": "Text for strong password",
        "dataTypes": ["string"],
        "examples": ["'Strong'", "'Excellent'"]
      }
    ],
    "styling": [
      {
        "name": "className",
        "type": "string",
        "optional": true,
        "description": "Additional CSS classes",
        "helpText": "Supports PrimeFlex utility classes",
        "examples": ["'w-full'"]
      },
      {
        "name": "style",
        "type": "React.CSSProperties",
        "optional": true,
        "description": "Inline styles",
        "helpText": "Standard React inline styles",
        "examples": ["{ width: '100%' }"]
      }
    ],
    "children": null
  },
  "eventHandlers": {
    "standard": [
      {
        "name": "onChange",
        "type": "(e: React.ChangeEvent<HTMLInputElement>) => void",
        "description": "Callback when password changes"
      },
      {
        "name": "onFocus",
        "type": "(e: React.FocusEvent) => void",
        "description": "Callback when input gains focus"
      },
      {
        "name": "onBlur",
        "type": "(e: React.FocusEvent) => void",
        "description": "Callback when input loses focus"
      }
    ],
    "simplified": [
      {
        "name": "onValueChange",
        "type": "(value: string) => void",
        "description": "Simplified callback with just the value"
      }
    ],
    "validation": [
      {
        "name": "onValidate",
        "type": "(value: string) => boolean | string",
        "description": "Validation callback"
      },
      {
        "name": "onError",
        "type": "(error: string) => void",
        "description": "Called when validation fails"
      }
    ],
    "lifecycle": [
      {
        "name": "onMount",
        "type": "() => void",
        "description": "Called when component mounts"
      },
      {
        "name": "onUnmount",
        "type": "() => void",
        "description": "Called when component unmounts"
      }
    ]
  },
  "eventHandlerMethods": {
    "internal": [
      "handleChange - Processes onChange event, calls onChange, onValueChange, onValidate",
      "handleFocus - Processes onFocus event",
      "handleBlur - Processes onBlur event, triggers validation"
    ],
    "patterns": [
      "Check if event handler exists before calling",
      "Extract value from event.target.value",
      "Run validation on blur and change events"
    ]
  },
  "childComponentInfo": {
    "allowedChildren": [],
    "childrenDescription": "This component does not accept children",
    "hasChildren": false,
    "examples": []
  },
  "stylingSupport": {
    "primeFlex": true,
    "responsive": true,
    "customCSS": true,
    "styleMerging": false
  },
  "usageExamples": {
    "basic": "<PasswordWrapper value={password} onChange={(e) => setPassword(e.target.value)} />",
    "withStyling": "<PasswordWrapper value={pwd} toggleMask className=\"w-full\" />",
    "withEvents": "<PasswordWrapper value={password} onChange={handleChange} onBlur={handleBlur} />",
    "withRedux": "<PasswordWrapper value={userPassword} onValueChange={(val) => dispatch(setPassword(val))} />",
    "withValidation": "<PasswordWrapper value={pwd} onValidate={(val) => val.length >= 8 ? true : 'Min 8 chars'} onError={(err) => setError(err)} />",
    "withChildren": "N/A"
  }
}
