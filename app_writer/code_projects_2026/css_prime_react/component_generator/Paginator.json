{
  "name": "Paginator",
  "import": "Paginator",
  "category": "Data",
  "metadata": {
    "description": "Pagination controls",
    "usageExamples": [
      "<PaginatorWrapper first={first} rows={rows} totalRecords={120} onPageChange={onPageChange} />",
      "<PaginatorWrapper first={0} rows={10} totalRecords={100} rowsPerPageOptions={[10, 20, 30]} />"
    ]
  },
  "propsInterface": {
    "componentSpecific": [
      {
        "name": "first",
        "type": "number",
        "optional": false,
        "description": "First row index",
        "helpText": "Index of first row (0-based)",
        "dataTypes": ["number"],
        "examples": ["0", "10", "20"]
      },
      {
        "name": "rows",
        "type": "number",
        "optional": false,
        "description": "Rows per page",
        "helpText": "Number of rows to display per page",
        "dataTypes": ["number"],
        "examples": ["10", "25", "50"]
      },
      {
        "name": "totalRecords",
        "type": "number",
        "optional": false,
        "description": "Total records",
        "helpText": "Total number of records",
        "dataTypes": ["number"],
        "examples": ["100", "1000"]
      },
      {
        "name": "rowsPerPageOptions",
        "type": "number[]",
        "optional": true,
        "description": "Rows per page options",
        "helpText": "Array of options for rows per page dropdown",
        "dataTypes": ["number[]"],
        "examples": ["[10, 20, 30]", "[5, 10, 25, 50]"]
      },
      {
        "name": "pageLinkSize",
        "type": "number",
        "optional": true,
        "description": "Page link size",
        "helpText": "Number of page links to display (default: 5)",
        "dataTypes": ["number"],
        "examples": ["5", "7", "10"]
      },
      {
        "name": "template",
        "type": "string",
        "optional": true,
        "description": "Template string",
        "helpText": "Custom template for paginator layout",
        "dataTypes": ["string"],
        "examples": ["'FirstPageLink PrevPageLink PageLinks NextPageLink LastPageLink'"]
      }
    ],
    "styling": [
      {
        "name": "className",
        "type": "string",
        "optional": true,
        "description": "Additional CSS classes",
        "helpText": "Supports PrimeFlex utility classes",
        "examples": ["'mb-3'"]
      },
      {
        "name": "style",
        "type": "React.CSSProperties",
        "optional": true,
        "description": "Inline styles",
        "helpText": "Standard React inline styles",
        "examples": ["{ marginBottom: '1rem' }"]
      }
    ],
    "children": null
  },
  "eventHandlers": {
    "standard": [
      {
        "name": "onPageChange",
        "type": "(e: { first: number, rows: number, page: number, pageCount: number }) => void",
        "description": "Callback when page changes"
      }
    ],
    "simplified": [],
    "validation": [],
    "lifecycle": [
      {
        "name": "onMount",
        "type": "() => void",
        "description": "Called when component mounts"
      },
      {
        "name": "onUnmount",
        "type": "() => void",
        "description": "Called when component unmounts"
      }
    ]
  },
  "eventHandlerMethods": {
    "internal": [
      "handlePageChange - Processes onPageChange event"
    ],
    "patterns": [
      "Check if event handler exists before calling",
      "Extract pagination data from event object"
    ]
  },
  "childComponentInfo": {
    "allowedChildren": [],
    "childrenDescription": "This component does not accept children",
    "hasChildren": false,
    "examples": []
  },
  "stylingSupport": {
    "primeFlex": true,
    "responsive": true,
    "customCSS": true,
    "styleMerging": false
  },
  "usageExamples": {
    "basic": "<PaginatorWrapper first={first} rows={10} totalRecords={120} onPageChange={(e) => setFirst(e.first)} />",
    "withStyling": "<PaginatorWrapper first={0} rows={10} totalRecords={100} rowsPerPageOptions={[10, 20, 30]} className=\"mb-3\" />",
    "withEvents": "<PaginatorWrapper first={first} rows={rows} totalRecords={total} onPageChange={handlePageChange} />",
    "withRedux": "<PaginatorWrapper first={pageFirst} rows={pageRows} totalRecords={totalRecords} onPageChange={(e) => dispatch(setPage(e))} />",
    "withValidation": "N/A",
    "withChildren": "N/A"
  }
}
